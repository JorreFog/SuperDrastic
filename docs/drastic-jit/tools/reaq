#!/usr/bin/env python3
# reaq TOOL 'json-args'   |  reaq --list
import json, socket, sys
import os
SOCK = os.environ.get("REA_SOCK", "/tmp/rea.sock")   # same path you passed to reamcpd.py
req = {"list": True} if sys.argv[1] == "--list" else {"tool": sys.argv[1], "args": json.loads(sys.argv[2] if len(sys.argv) > 2 else "{}")}
c = socket.socket(socket.AF_UNIX); c.connect(SOCK); c.sendall(json.dumps(req).encode() + b"\n")
data = b""
while True:
    b = c.recv(1 << 20)
    if not b: break
    data += b
r = json.loads(data)
if "error" in r: print(json.dumps(r["error"], indent=1)); sys.exit(1)
res = r["result"]
if "tools" in res:
    for t in res["tools"]: print(t["name"], "-", t.get("description", "")[:110])
    sys.exit(0)
for c in res.get("content", []):
    if c.get("type") == "text": print(c["text"])
if res.get("isError"): sys.exit(2)
