     // clipping
 
-    nverts = ClipPolygon<true>(*this, clippedvertices, nverts, clipstart);
+    if constexpr (Fast)
+    {
+        // GeomFast: ClipPolygon changes nothing but the colours (made x.FFF, which unclipped vertices are) when the
+        // vertices it tests are inside the view volume, so test them first, with ClipAgainstPlane's comparisons
+        // (a wrapping -w, as GCC compiles its -vtx.Position[3])
+        // (and per plane: a pass of ClipAgainstPlane with no vertex outside its plane only does that to the colours)
+        u32 outside = 0;
+        for (int i = clipstart; i < nverts; i++)
+        {
+            const s32* p = clippedvertices[i].Position;
+            const s32 w = p[3], nw = (s32)(0u - (u32)w);
+            outside |= ((p[0] > w) | (p[0] < nw)) | (((p[1] > w) | (p[1] < nw)) << 1) | (((p[2] > w) | (p[2] < nw)) << 2);
+        }
+        // When no pass runs, the colours are left as they are: they already are x.FFF (SubmitVertex makes the
+        // vertices' so, and the shared ones of a strip went through this), and only the new vertices' are kept.
+        if (outside)
+        {
+            if (outside & 4)
+                nverts = ClipAgainstPlane<2, true>(*this, clippedvertices, nverts, clipstart);
+            // (a pass after one that returned 0 still runs: with a strip's clipstart of 2 it returns 2)
+            if (nverts == 0 || ClipPlaneOutside<1>(clippedvertices, nverts, clipstart))
+                nverts = ClipAgainstPlane<1, true>(*this, clippedvertices, nverts, clipstart);
+            if (nverts == 0 || ClipPlaneOutside<0>(clippedvertices, nverts, clipstart))
+                nverts = ClipAgainstPlane<0, true>(*this, clippedvertices, nverts, clipstart);
+            // a pass that ran made every vertex's colour x.FFF; the vertices of a skipped one already were
+        }
+    }
+    else
+        nverts = ClipPolygon<true>(*this, clippedvertices, nverts, clipstart);
