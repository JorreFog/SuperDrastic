+// GeomFast: whether a vertex ClipAgainstPlane<comp> tests is outside its plane (a wrapping -w, as GCC compiles its
+// -vtx.Position[3])
+template<int comp>
+static inline bool ClipPlaneOutside(const Vertex* vertices, int nverts, int clipstart)
+{
+    bool outside = false;
+    for (int i = clipstart; i < nverts; i++)
+    {
+        const s32 p = vertices[i].Position[comp], w = vertices[i].Position[3];
+        outside |= (p > w) | (p < (s32)(0u - (u32)w));
+    }
+    return outside;
+}
