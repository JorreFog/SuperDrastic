+namespace
+{
+// NDS::DMAs is protected: a member pointer named through a derived class reaches it (GeomFast's CheckFIFODMAFast
+// does NDS::CheckDMAs(0, 7) inline: the DS's four ARM9 DMAs, in order)
+struct NDSDMAs : melonDS::NDS
+{
+    static DMA* Get(melonDS::NDS& nds) noexcept { return nds.*(&NDSDMAs::DMAs); }
+};
+}
+
+inline __attribute__((always_inline)) void GPU3D::CmdFIFOWriteFast(CmdFIFOEntry entry) noexcept
+{
+    // CmdFIFOWrite, inline
+    if (CmdFIFO.IsEmpty() && !CmdPIPE.IsFull())
+    {
+        CmdPIPE.Write(entry);
+    }
+    else
+    {
+        if (CmdFIFO.IsFull())
+        {
+            CmdStallQueue.Write(entry);
+            NDS.GXFIFOStall();
+            return;
+        }
+
+        CmdFIFO.Write(entry);
+    }
+
+    GXStat |= (1<<27);
+
+    if (entry.Command == 0x11 || entry.Command == 0x12)
+    {
+        GXStat |= (1<<14); // push/pop matrix
+        NumPushPopCommands++;
+    }
+    else if (entry.Command == 0x70 || entry.Command == 0x71 || entry.Command == 0x72)
+    {
+        GXStat |= (1<<0); // box/pos/vec test
+        NumTestCommands++;
+    }
+}
+
+inline __attribute__((always_inline)) void GPU3D::CheckFIFODMAFast() noexcept
+{
+    if (CmdFIFO.Level() < 128 && GXFIFODMAMaybe)
+    {
+        if (NDS.ConsoleType == 0)
+        {
+            DMA* dma = NDSDMAs::Get(NDS);
+            dma[0].StartIfNeeded(0x07);
+            dma[1].StartIfNeeded(0x07);
+            dma[2].StartIfNeeded(0x07);
+            dma[3].StartIfNeeded(0x07);
+            // none waits for the GX FIFO: none can until DMA::WriteCnt enables one in that mode, which calls
+            // CheckFIFODMA (StartMode changes only there, as the enable bit goes from 0 to 1)
+            GXFIFODMAMaybe = dma[0].IsInMode(0x07) || dma[1].IsInMode(0x07) || dma[2].IsInMode(0x07) ||
+                             dma[3].IsInMode(0x07);
+        }
+        else
+            NDS.CheckDMAs(0, 0x07);
+    }
+}
+
+inline __attribute__((always_inline)) void GPU3D::CheckFIFOIRQFast() noexcept
+{
+    bool irq = false;
+    switch (GXStat >> 30)
+    {
+    case 1: irq = (CmdFIFO.Level() < 128); break;
+    case 2: irq = CmdFIFO.IsEmpty(); break;
+    }
+
+    // NDS::SetIRQ/ClearIRQ(0, IRQ_GXFIFO) and their UpdateIRQ(0), inline (the ARM9's: no DSi part, no wake-up).
+    // When IF's bit stays as it is, they change nothing: the ARM9's IRQ already is UpdateIRQ's result for these
+    // IME, IE and IF, since every write of those three is followed by UpdateIRQ(0) and Reset clears all four;
+    // only a state load can leave it otherwise, so the first check after one (or a reset) does the update.
+    const u32 oldif = NDS.IF[0];
+    const u32 newif = irq ? (oldif | (1 << IRQ_GXFIFO)) : (oldif & ~(1 << IRQ_GXFIFO));
+    if (newif == oldif && GXIRQSynced) [[likely]]
+        return;
+    NDS.IF[0] = newif;
+    NDS.ARM9.IRQ = (NDS.IME[0] & 0x1) ? !!(NDS.IE[0] & newif) : 0;
+    GXIRQSynced = true;
+}
+
+inline __attribute__((always_inline)) GPU3D::CmdFIFOEntry GPU3D::CmdFIFOReadFast() noexcept
+{
+    // CmdFIFORead, with the DMA and IRQ checks inline
+    CmdFIFOEntry ret = CmdPIPE.Read();
+
+    if (CmdPIPE.Level() <= 2)
+    {
+        if (!CmdFIFO.IsEmpty())
+            CmdPIPE.Write(CmdFIFO.Read());
+        if (!CmdFIFO.IsEmpty())
+            CmdPIPE.Write(CmdFIFO.Read());
+
+        if (!CmdStallQueue.IsEmpty()) [[unlikely]]
+        {
+            while (!CmdStallQueue.IsEmpty())
+            {
+                if (CmdFIFO.IsFull()) break;
+                CmdFIFOEntry entry = CmdStallQueue.Read();
+                CmdFIFOWrite(entry);
+            }
+
+            if (CmdStallQueue.IsEmpty())
