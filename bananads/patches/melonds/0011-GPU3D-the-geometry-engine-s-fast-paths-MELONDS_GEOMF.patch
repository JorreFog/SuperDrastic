+__attribute__((no_stack_protector)) void GPU3D::RunFast() noexcept
+{
+    // Run, with the commands' work inline
+    const u64 now = NDS.ARM9Timestamp >> NDS.ARM9ClockShift;
+    if (!GeometryEnabled || FlushRequest ||
+        (CmdPIPE.IsEmpty() && !(GXStat & (1<<27))))
+    {
+        Timestamp = now;
+        return;
+    }
+
+    s32 cycles = now - Timestamp;
+    CycleCount -= cycles;
+    Timestamp = now;
+
+    while (CycleCount <= 0 && !CmdPIPE.IsEmpty())
+    {
+        GXStat &= ~(((u32)(NumPushPopCommands == 0) << 14) | (u32)(NumTestCommands == 0));
+
+        ExecuteCommandBody<true>();
+    }
+
+    if (CycleCount <= 0 && CmdPIPE.IsEmpty())
+    {
+        if (GXStat & (1<<27))
+        {
+            // FinishWork, inline
+            const s32 cycles = -CycleCount;
+            AddCyclesT<true>(cycles);
+            if (NormalPipeline)
+                NormalPipeline -= std::min(NormalPipeline, cycles);
+
+            CycleCount = 0;
+
+            if (!(VertexPipeline || NormalPipeline || PolygonPipeline))
+                GXStat &= ~(1<<27);
+        }
+        else
+            CycleCount = 0;
+
+        if (NumPushPopCommands == 0) GXStat &= ~(1<<14);
+        if (NumTestCommands == 0)    GXStat &= ~(1<<0);
+    }
+}
