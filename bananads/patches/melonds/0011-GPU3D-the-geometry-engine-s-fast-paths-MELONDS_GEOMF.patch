+
+#ifndef GPU3D_NEON_H
+#define GPU3D_NEON_H
+
+// The geometry engine's matrix and vertex math for GPU3D's fast paths (GeomFast), bit for bit the plain C code's:
+// every product is s32 x s32 -> s64, the sums are s64 (wrapping, as the C code's), and each result is the sum >> 12
+// truncated to 32 bits (shrn). With NEON a row of four results is two smull/smlal chains and two shrn.
+
+#include <string.h>
+#include "types.h"
+
+#if defined(__aarch64__) && defined(__ARM_NEON)
+#include <arm_neon.h>
+#define GPU3D_NEON 1
+#endif
+
+namespace melonDS::GeomFastMath
+{
+
+#ifdef GPU3D_NEON
+
+// a + b, two s64 lanes each, >> 12 to four s32
+inline int32x4_t Narrow12(int64x2_t lo, int64x2_t hi)
+{
+    return vcombine_s32(vshrn_n_s64(lo, 12), vshrn_n_s64(hi, 12));
+}
+
+// out[0..3] = (x*m[0..3] + y*m[4..7] + z*m[8..11] + 0x1000*m[12..15]) >> 12 (a vertex by a 4x4 matrix)
+inline void Transform(s32* out, const s32* m, s32 x, s32 y, s32 z)
+{
+    const int32x4_t r0 = vld1q_s32(m), r1 = vld1q_s32(m + 4), r2 = vld1q_s32(m + 8), r3 = vld1q_s32(m + 12);
+    int64x2_t lo = vshll_n_s32(vget_low_s32(r3), 12);
+    int64x2_t hi = vshll_high_n_s32(r3, 12);
+    lo = vmlal_n_s32(lo, vget_low_s32(r0), x); hi = vmlal_high_n_s32(hi, r0, x);
+    lo = vmlal_n_s32(lo, vget_low_s32(r1), y); hi = vmlal_high_n_s32(hi, r1, y);
+    lo = vmlal_n_s32(lo, vget_low_s32(r2), z); hi = vmlal_high_n_s32(hi, r2, z);
+    vst1q_s32(out, Narrow12(lo, hi));
+}
+
+// m = s*m for a 4x4 s (MatrixMult4x4)
+inline void Mult4x4(s32* m, const s32* s)
+{
+    const int32x4_t t0 = vld1q_s32(m), t1 = vld1q_s32(m + 4), t2 = vld1q_s32(m + 8), t3 = vld1q_s32(m + 12);
+    for (int i = 0; i < 4; i++)
+    {
+        const s32* r = s + i * 4;
+        int64x2_t lo = vmull_n_s32(vget_low_s32(t0), r[0]);
+        int64x2_t hi = vmull_high_n_s32(t0, r[0]);
+        lo = vmlal_n_s32(lo, vget_low_s32(t1), r[1]); hi = vmlal_high_n_s32(hi, t1, r[1]);
+        lo = vmlal_n_s32(lo, vget_low_s32(t2), r[2]); hi = vmlal_high_n_s32(hi, t2, r[2]);
+        lo = vmlal_n_s32(lo, vget_low_s32(t3), r[3]); hi = vmlal_high_n_s32(hi, t3, r[3]);
+        vst1q_s32(m + i * 4, Narrow12(lo, hi));
+    }
+}
+
+// m = s*m for a 4x3 s (MatrixMult4x3: the last row is s[9..11] and 0x1000)
+inline void Mult4x3(s32* m, const s32* s)
+{
+    const int32x4_t t0 = vld1q_s32(m), t1 = vld1q_s32(m + 4), t2 = vld1q_s32(m + 8), t3 = vld1q_s32(m + 12);
+    for (int i = 0; i < 4; i++)
+    {
+        const s32* r = s + i * 3;
+        int64x2_t lo = vmull_n_s32(vget_low_s32(t0), r[0]);
+        int64x2_t hi = vmull_high_n_s32(t0, r[0]);
+        lo = vmlal_n_s32(lo, vget_low_s32(t1), r[1]); hi = vmlal_high_n_s32(hi, t1, r[1]);
+        lo = vmlal_n_s32(lo, vget_low_s32(t2), r[2]); hi = vmlal_high_n_s32(hi, t2, r[2]);
+        if (i == 3)
+        {
+            lo = vaddq_s64(lo, vshll_n_s32(vget_low_s32(t3), 12));
+            hi = vaddq_s64(hi, vshll_high_n_s32(t3, 12));
+        }
+        vst1q_s32(m + i * 4, Narrow12(lo, hi));
+    }
+}
+
+// m = s*m for a 3x3 s (MatrixMult3x3: the first three rows only)
+inline void Mult3x3(s32* m, const s32* s)
+{
+    const int32x4_t t0 = vld1q_s32(m), t1 = vld1q_s32(m + 4), t2 = vld1q_s32(m + 8);
+    for (int i = 0; i < 3; i++)
+    {
+        const s32* r = s + i * 3;
+        int64x2_t lo = vmull_n_s32(vget_low_s32(t0), r[0]);
+        int64x2_t hi = vmull_high_n_s32(t0, r[0]);
+        lo = vmlal_n_s32(lo, vget_low_s32(t1), r[1]); hi = vmlal_high_n_s32(hi, t1, r[1]);
+        lo = vmlal_n_s32(lo, vget_low_s32(t2), r[2]); hi = vmlal_high_n_s32(hi, t2, r[2]);
+        vst1q_s32(m + i * 4, Narrow12(lo, hi));
+    }
+}
+
+// m[12..15] += (s[0]*m[0..3] + s[1]*m[4..7] + s[2]*m[8..11]) >> 12 (MatrixTranslate)
+inline void Translate(s32* m, const s32* s)
+{
+    const int32x4_t t0 = vld1q_s32(m), t1 = vld1q_s32(m + 4), t2 = vld1q_s32(m + 8), t3 = vld1q_s32(m + 12);
+    int64x2_t lo = vmull_n_s32(vget_low_s32(t0), s[0]);
+    int64x2_t hi = vmull_high_n_s32(t0, s[0]);
+    lo = vmlal_n_s32(lo, vget_low_s32(t1), s[1]); hi = vmlal_high_n_s32(hi, t1, s[1]);
+    lo = vmlal_n_s32(lo, vget_low_s32(t2), s[2]); hi = vmlal_high_n_s32(hi, t2, s[2]);
+    vst1q_s32(m + 12, vaddq_s32(t3, Narrow12(lo, hi)));
+}
+
+#else
+
+inline void Transform(s32* out, const s32* m, s32 x, s32 y, s32 z)
+{
+    for (int j = 0; j < 4; j++)
+        out[j] = ((s64)x*m[j] + (s64)y*m[4+j] + (s64)z*m[8+j] + (s64)0x1000*m[12+j]) >> 12;
+}
+
+inline void Mult4x4(s32* m, const s32* s)
+{
+    s32 t[16]; memcpy(t, m, 16*4);
+    for (int i = 0; i < 4; i++) for (int j = 0; j < 4; j++)
+        m[i*4+j] = ((s64)s[i*4]*t[j] + (s64)s[i*4+1]*t[4+j] + (s64)s[i*4+2]*t[8+j] + (s64)s[i*4+3]*t[12+j]) >> 12;
+}
+
+inline void Mult4x3(s32* m, const s32* s)
+{
+    s32 t[16]; memcpy(t, m, 16*4);
+    for (int i = 0; i < 4; i++) for (int j = 0; j < 4; j++)
+        m[i*4+j] = ((s64)s[i*3]*t[j] + (s64)s[i*3+1]*t[4+j] + (s64)s[i*3+2]*t[8+j] + (i == 3 ? (s64)0x1000*t[12+j] : 0)) >> 12;
+}
+
+inline void Mult3x3(s32* m, const s32* s)
+{
+    s32 t[12]; memcpy(t, m, 12*4);
+    for (int i = 0; i < 3; i++) for (int j = 0; j < 4; j++)
+        m[i*4+j] = ((s64)s[i*3]*t[j] + (s64)s[i*3+1]*t[4+j] + (s64)s[i*3+2]*t[8+j]) >> 12;
+}
+
+inline void Translate(s32* m, const s32* s)
+{
+    for (int j = 0; j < 4; j++)
+        m[12+j] += ((s64)s[0]*m[j] + (s64)s[1]*m[4+j] + (s64)s[2]*m[8+j]) >> 12;
+}
+
+#endif
+
+}
+
+#endif
