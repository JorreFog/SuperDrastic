+
+bool Compiler::ReadPinEnv()
+{
+    u32 m[2] = {0, 0};
+    const char* e9 = getenv("MELONDS_JIT_PINREGS");
+    const char* e7 = getenv("MELONDS_JIT_PINREGS7");
+    if (e9)
+        m[0] = (u32)strtoul(e9, nullptr, 16) & 0x7FFF;
+    m[1] = e7 ? ((u32)strtoul(e7, nullptr, 16) & 0x7FFF) : m[0];
+    // at most 7 (w19-w25): the lowest bits win
+    for (int num = 0; num < 2; num++)
+        while (__builtin_popcount(m[num]) > 7)
+            m[num] &= ~(1u << (31 - __builtin_clz(m[num])));
+    const bool changed = m[0] != PinMask[0] || m[1] != PinMask[1];
+    PinMask[0] = m[0];
+    PinMask[1] = m[1];
+    return changed;
+}
+
+void Compiler::SetupPins()
+{
+    for (int num = 0; num < 2; num++)
+    {
+        int next = W19;
+        for (int reg = 0; reg < 16; reg++)
+        {
+            PinHome[num][reg] = INVALID_REG;
+            if (PinMask[num] & (1u << reg))
+                PinHome[num][reg] = (ARM64Reg)next++;
+        }
+        // the prologue: FASTENTRY's x26 (OptFastEntry && !OptNoPrologue), then the pinned loads (pairs of
+        // neighbouring registers in one LDP)
+        const u64 base = (u64)(uintptr_t)(num == 0 ? NDS.JIT.Memory.FastMem9Start : NDS.JIT.Memory.FastMem7Start);
+        u32 n = 0;
+        if (OptFastEntry && !OptNoPrologue)
+        {
+            n = 1;
+            for (int hw = 1; hw < 4; hw++)
+                n += ((base >> (16 * hw)) & 0xFFFF) != 0;
+        }
+        for (u32 bits = PinMask[num]; bits; n++)
+        {
+            const int reg = __builtin_ctz(bits);
+            bits &= ~(1u << reg);
+            if (reg < 14 && (bits & (1u << (reg + 1))))
+                bits &= ~(1u << (reg + 1));
+        }
+        EntrySkip[num] = OptFastEntry ? 4 * n : 0;
+    }
+    FillRetStub();
+    FillDynExitBases();
+}
+
+void Compiler::Comp_PinnedSync(bool store)
+{
+    for (u32 bits = PinMask[Num]; bits;)
+    {
+        const int reg = __builtin_ctz(bits);
+        bits &= ~(1u << reg);
+        const ARM64Reg a = PinHome[Num][reg];
+        if (reg < 14 && (bits & (1u << (reg + 1))))
+        {
+            bits &= ~(1u << (reg + 1));
+            const ARM64Reg b = PinHome[Num][reg + 1];
+            if (store)
+                STP(INDEX_SIGNED, a, b, RCPU, offsetof(ARM, R) + reg * 4);
+            else
+                LDP(INDEX_SIGNED, a, b, RCPU, offsetof(ARM, R) + reg * 4);
+        }
+        else if (store)
+            STR(INDEX_UNSIGNED, a, RCPU, offsetof(ARM, R) + reg * 4);
+        else
+            LDR(INDEX_UNSIGNED, a, RCPU, offsetof(ARM, R) + reg * 4);
+    }
+}
+
+void Compiler::FillRetStub()
+{
+    // RetStub: the CPU's pinned registers (RCPU says which CPU: the ARM9's and the ARM7's masks are the same set of
+    // host registers only when the masks are equal, so with two different masks the stub tells them apart by
+    // RCPU's Num), then ARM_Ret through x16 (ARM_Ret may be out of a B's reach)
+    NDS.JIT.JitEnableWrite();
+    const ptrdiff_t saved = GetCodeOffset();
+    SetCodePtrUnsafe(RetStubRW - RWBase());
+    const u32 savedNum = Num;
+    FixupBranch other;
+    const bool two = PinMask[0] != PinMask[1];
+    if (two)
+    {
+        LDR(INDEX_UNSIGNED, W16, RCPU, offsetof(ARM, Num));
+        other = CBNZ(W16);
+    }
+    Num = 0;
+    Comp_PinnedSync(true);
+    auto tail = [&]()
+    {
+        const bool pad = ((uintptr_t)GetRXPtr() + 8) & 7;
+        Write32(0x58000000 | ((pad ? 3 : 2) << 5) | 16);   // ldr x16, <the literal below>
+        BR(X16);
+        if (pad)
+            Write32(0xD503201F);
+        const u64 ret = (u64)(uintptr_t)ARM_Ret;
+        Write32((u32)ret);
+        Write32((u32)(ret >> 32));
+    };
+    tail();
+    if (two)
+    {
+        SetJumpTarget(other);
+        Num = 1;
+        Comp_PinnedSync(true);
+        tail();
+    }
+    Num = savedNum;
+    assert(GetWriteableRWPtr() <= RetStubRW + 128);
+    SetCodePtrUnsafe(saved);
+    FlushIcacheSection(RetStubRX, RetStubRX + 128);
+    NDS.JIT.JitEnableExecute();
+}
+
+void Compiler::FillDynExitBases()
+{
+    NDS.JIT.JitEnableWrite();
+    for (int num = 0; num < 2; num++)
+    for (int c = 0; c < 2; c++)
+    {
+        // (+ the entry prologue's size: a linked entry skips it)
+        const u64 base = (u64)(uintptr_t)GetRXBase() + EntrySkip[num];
+        u32* p = DynExitBase[num][c];
+        if (DynExitLiteral)
+        {
+            memcpy(p, &base, 8);   // (data: the stub loads it)
+            if (DynExitBaseA[num][c])
+                memcpy(DynExitBaseA[num][c], &base, 8);
+            continue;
+        }
+        p[0] = 0xD2800000 | ((u32)(base & 0xFFFF) << 5) | 17;                       // movz x17, #.., lsl #0
+        for (int hw = 1; hw < 4; hw++)
+            p[hw] = 0xF2800000 | (hw << 21) | ((u32)((base >> (16 * hw)) & 0xFFFF) << 5) | 17;  // movk x17, #.., lsl #16*hw
+        FlushIcacheSection((u8*)p, (u8*)(p + 4));
+    }
+    NDS.JIT.JitEnableExecute();
 }
 
