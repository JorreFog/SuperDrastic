 {
     if (J3Stats) J3ExitStats[24 + 32 * cpu->Num]++;
+    if constexpr (std::is_same_v<T, ARMv5>)
+    {
+        if (J3FastIRQ)
+        {
+            cpu->JumpToJIT(addr, changeCPSR);
+            return;
+        }
+    }
     cpu->JumpTo(addr, changeCPSR);
 }
 
