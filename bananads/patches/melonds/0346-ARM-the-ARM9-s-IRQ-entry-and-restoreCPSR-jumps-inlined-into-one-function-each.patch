 void ARMv5::JumpTo(u32 addr, bool restorecpsr)
+{
+    JumpToInl(addr, restorecpsr);
+}
+
+// J3 FASTIRQ (patch 0346): the JIT's restoreCPSR jumps (JumpToTrampoline) and the loop's TriggerIRQ for the ARM9
+// through one function each with JumpTo, RestoreCPSR and UpdateMode inlined into it (the same code, fewer calls and
+// cold cache lines). J3FastIRQ = 0 (MELONDS_JIT_NOFASTIRQ=1): the calls as before.
+u8 J3FastIRQ = 1;
+
+[[gnu::noinline]] void ARMv5::JumpToJIT(u32 addr, bool restorecpsr)
+{
+    JumpToInl(addr, restorecpsr);
+}
+
+[[gnu::noinline]] void ARMv5::TriggerIRQJIT()
+{
+    // ARM::TriggerIRQ for the ARM9 (no ARDS part: that is the ARM7's)
+    if (CPSR & 0x80)
+        return;
+
+    u32 oldcpsr = CPSR;
+    CPSR &= ~0xFF;
+    CPSR |= 0xD2;
+    UpdateModeInl(oldcpsr, CPSR);
+
+    R_IRQ[2] = oldcpsr;
+    R[14] = R[15] + (oldcpsr & 0x20 ? 2 : 0);
+    JumpToInl(ExceptionBase + 0x18, false);
+}
+
+[[gnu::always_inline]] inline void ARMv5::JumpToInl(u32 addr, bool restorecpsr)
 {
     if (restorecpsr)
     {
-        RestoreCPSR();
+        RestoreCPSRInl();
 
         if (CPSR & 0x20)    addr |= 0x1;
         else                addr &= ~0x1;
