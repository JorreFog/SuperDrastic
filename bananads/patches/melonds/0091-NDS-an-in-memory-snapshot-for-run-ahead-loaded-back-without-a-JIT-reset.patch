+    // NDS's timing tables too), the PU maps and the timing table (6 MB) aren't made again
+    const u32 leanCtl = CP15Control, leanDTCM = DTCMSetting, leanITCM = ITCMSetting;
+    const u32 leanPU[5] = {PU_CodeCacheable, PU_DataCacheable, PU_DataCacheWrite, PU_CodeRW, PU_DataRW};
+    u32 leanRegions[8];
+    memcpy(leanRegions, PU_Region, sizeof(leanRegions));
+
     file->Var32(&CP15Control);
 
     file->Var32(&DTCMSetting);
@@ -96,9 +103,14 @@ void ARMv5::CP15DoSavestate(Savestate* file)
 
     if (!file->Saving)
     {
-        UpdateDTCMSetting();
-        UpdateITCMSetting();
-        UpdatePURegions(true);
+        const u32 pu[5] = {PU_CodeCacheable, PU_DataCacheable, PU_DataCacheWrite, PU_CodeRW, PU_DataRW};
+        if (!NDS.LeanSavestate || NDS.LeanTimingsChanged || CP15Control != leanCtl || DTCMSetting != leanDTCM
+            || ITCMSetting != leanITCM || memcmp(pu, leanPU, sizeof(pu)) || memcmp(PU_Region, leanRegions, sizeof(leanRegions)))
+        {
+            UpdateDTCMSetting();
+            UpdateITCMSetting();
+            UpdatePURegions(true);
+        }
     }
 }
 
