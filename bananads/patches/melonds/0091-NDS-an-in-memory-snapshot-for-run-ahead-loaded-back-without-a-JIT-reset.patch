 void ARMv5::DoSavestate(Savestate* file)
 {
     ARM::DoSavestate(file);
     CP15DoSavestate(file);
+    if (NDS.LeanSavestate)
+    {
+        // (patch 0091) the instruction cache and its replacement seed: timings a state file starts over
+        file->Var32(&RNGSeed);
+        file->Var32(&TraceProcessID);
+        file->Var32((u32*)&RegionCodeCycles);
+        file->VarArray(ICache, sizeof(ICache));
+        file->VarArray(ICacheTags, sizeof(ICacheTags));
+        file->VarArray(ICacheCount, sizeof(ICacheCount));
+        s32 line = CurICacheLine ? (s32)(CurICacheLine - ICache) : -1;
+        file->Var32((u32*)&line);
+        if (!file->Saving) CurICacheLine = line >= 0 ? ICache + line : nullptr;
+    }
 }
 
 
diff --git a/src/ARMJIT.cpp b/src/ARMJIT.cpp
index 065b495..21bd6f5 100644
--- a/src/ARMJIT.cpp
+++ b/src/ARMJIT.cpp
@@ -1547,6 +1547,52 @@ void ARMJIT::CompileBlock(ARM* cpu) noexcept
     u64* entry = &FastBlockLookupRegions[(localAddr >> 27)][(localAddr & 0x7FFFFFF) / 2];
     *entry = ((u64)blockAddr | cpu->Num) << 32;
     *entry |= JITCompiler.SubEntryOffset(block->EntryPoint);
+    if (TrackingNewBlocks) NewBlocks.push_back(block);  // (patch 0091)
+}
+
+// BananaDS run-ahead (patch 0091): after a snapshot taken with TrackNewBlocks(true) is loaded back, every block
+// compiled since and still there goes, and only those (deleted, not retired: a block the frames ahead compiled is
+// compiled again when the game gets there, as it would have been without them). Blocks from before the snapshot
+// stay: memory they were compiled from that the frames since wrote was invalidated by those writes (and dropped
+// them), the rest is what the load puts back unchanged.
+void ARMJIT::DropNewBlocks() noexcept
+{
+    TrackingNewBlocks = false;
+    for (JitBlock* block : NewBlocks)
+    {
+        for (int j = 0; j < block->NumAddresses; j++)
+        {
+            u32 addr = block->AddressRanges()[j];
+            AddressRange* region = CodeMemRegions[addr >> 27];
+            AddressRange* range = &region[(addr & 0x7FFFFFF) / 512];
+            bool removed = range->Blocks.RemoveByValue(block);
+            assert(removed);
+            (void)removed;
+            if (!HotRangeIdx.empty())
+                if (auto ix = HotRangeIdx.find(range); ix != HotRangeIdx.end())
+                    for (size_t q = 0; q < ix->second.size(); q++)
+                        if (ix->second[q].first == block) { ix->second.erase(ix->second.begin() + q); break; }
+            u32 code = 0;  // the 16-byte granules the range's other blocks still cover
+            for (int i = 0; i < range->Blocks.Length; i++)
+            {
+                JitBlock* other = range->Blocks[i];
+                for (int k = 0; k < other->NumAddresses; k++)
+                    if (other->AddressRanges()[k] == addr) code |= other->AddressMasks()[k];
+            }
+            range->Code = code;
+            if (range->Blocks.Length == 0
+                && !PageContainsCode(&region[(addr & 0x7FFF000 & ~(Memory.PageSize - 1)) / 512], Memory.PageSize))
+                Memory.SetCodeProtection(addr >> 27, addr & 0x7FFFFFF, false);
+        }
+#if defined(__aarch64__)
+        JITCompiler.UnlinkBlock(block->EntryPoint);
+#endif
+        FastBlockLookupRegions[block->StartAddrLocal >> 27][(block->StartAddrLocal & 0x7FFFFFF) / 2] = (u64)UINT32_MAX << 32;
+        auto& map = block->Num == 0 ? JitBlocks9 : JitBlocks7;
+        if (auto it = map.find(block->StartAddr); it != map.end() && it->second == block) map.erase(it);
+        delete block;
+    }
+    NewBlocks.clear();
 }
 
 void ARMJIT::InvalidateByAddr(u32 localAddr) noexcept
@@ -1612,7 +1658,13 @@ void ARMJIT::InvalidateByAddr(u32 localAddr) noexcept
 
 void ARMJIT::InvalidateBlock(JitBlock* block, AddressRange* range, AddressRange* region, u32 localAddr) noexcept
 {
-    if (HotSmcOn() && HotSmc.size() < 16)
+    if (TrackingNewBlocks)  // (patch 0091) a frame run ahead: the block is no longer DropNewBlocks' to drop
+    {
+        for (size_t q = 0; q < NewBlocks.size(); q++)
+            if (NewBlocks[q] == block) { NewBlocks[q] = NewBlocks.back(); NewBlocks.pop_back(); break; }
+    }
+    // (patch 0091: and a frame run ahead's writes don't count towards a hot granule: they happen again for real)
+    if (HotSmcOn() && HotSmc.size() < 16 && !TrackingNewBlocks)
     {
         u32& n = SmcDrops[localAddr & ~15u];
         if (++n == 32) HotSmc.push_back(localAddr & ~15u);
@@ -1771,6 +1823,7 @@ template void ARMJIT::CheckAndInvalidate<1, ARMJIT_Memory::memregion_NewSharedWR
 
 void ARMJIT::ResetBlockCache() noexcept
 {
+    NewBlocks.clear();  // (patch 0091: every block goes)
     HotRangeIdx.clear();  // (patch 0018: the ranges are emptied below)
     // (the hot granules stay: they're the game's habit, not the cache's)
     Log(LogLevel::Debug, "Resetting JIT block cache...\n");
diff --git a/src/ARMJIT.h b/src/ARMJIT.h
index fa7b773..efc026a 100644
--- a/src/ARMJIT.h
+++ b/src/ARMJIT.h
@@ -105,6 +105,13 @@ public:
     std::unordered_map<u32, JitBlock*> JitBlocks7 {};
 
     std::unordered_map<u32, JitBlock*> RestoreCandidates {};
+    // BananaDS run-ahead (patch 0091): the blocks compiled (or restored) while TrackNewBlocks is on and still
+    // there. A snapshot loaded back without Reset() drops exactly those (DropNewBlocks): they may come from memory
+    // the frames run since the snapshot changed, which the load puts back without telling the JIT
+    bool TrackingNewBlocks = false;
+    std::vector<JitBlock*> NewBlocks {};
+    void TrackNewBlocks(bool on) noexcept { TrackingNewBlocks = on; if (on) NewBlocks.clear(); }
+    void DropNewBlocks() noexcept;
     // hot self-modifying code (patch 0017): 16-byte granules a write keeps dropping compiled blocks in; blocks stop
     // short of them, and a block starting in one stays in it, so each write recompiles only a few instructions
     std::unordered_map<u32, u32> SmcDrops {};
