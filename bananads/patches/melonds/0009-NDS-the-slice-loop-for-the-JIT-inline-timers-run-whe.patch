+    // FastSched: cancelling the event SchedNext holds sets it to 0, "to recompute" (often a new one follows: the
+    // divider and sqrt unit cancel and reschedule theirs on every parameter write). The next RunSystem walks the
+    // list, firing only what is due as always, and rebuilds it; NextTarget recomputes it if it comes first.
+    char* const sb = PinAddress(reinterpret_cast<char*>(&SysTimestamp));
+    const u32 mask = SCHED(sb, SchedListMask);
+    if ((mask & (1<<id)) && SchedList[id].Timestamp == SCHED(sb, SchedNext))
+        SCHED(sb, SchedNext) = 0;
+    SCHED(sb, SchedListMask) = mask & ~(1<<id);
 }
 
 
@@ -1746,6 +2110,32 @@ void NDS::RunTimers(u32 cpu)
     if (timermask & 0x8) RunTimer((cpu<<2)+3, cycles);
 
     TimerTimestamp[cpu] += cycles;
+
