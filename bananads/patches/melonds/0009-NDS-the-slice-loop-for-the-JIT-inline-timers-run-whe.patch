+#ifdef JIT_ENABLED
+// (out of line, so that the loop doesn't keep its arguments' addresses in registers)
+template <u32 num, typename CPU>
+[[gnu::noinline, gnu::cold]] static bool SetupExecutableRegionFor(NDS& nds, CPU& cpu, u32 instrAddr)
+{
+    if (nds.JIT.SetupExecutableRegion(num, instrAddr, cpu.FastBlockLookup, cpu.FastBlockLookupStart, cpu.FastBlockLookupSize))
+        return true;
+    Log(LogLevel::Error, num ? "ARMv4 PC in non executable region %08X\n" : "ARMv5 PC in non executable region %08X\n", cpu.R[15]);
+    return false;
+}
+
+// ARMv5/ARMv4::Execute<JIT>'s block loop and its end, for a CPU that isn't halted (FastLoop)
+template <u32 num, typename CPU>
+[[gnu::always_inline]] static inline void ExecuteJITInline(NDS& nds, CPU& cpu, u64& timestamp, u64& target, u8* const rxBase)
+{
+    while (timestamp < target)
+    {
+        // R[15] - (Thumb ? 2 : 4)
+        u32 instrAddr = cpu.R[15] - 4 + ((cpu.CPSR >> 4) & 2);
+
+        // (one compare for melonDS's instrAddr < start || instrAddr >= start + size: they differ only for a
+        // region whose end wraps past 2^32, the ARM9 BIOS's last mirror, where melonDS sets the same region up
+        // again for every block and this doesn't)
+        u32 offset = instrAddr - cpu.FastBlockLookupStart;
+        if (offset >= cpu.FastBlockLookupSize) [[unlikely]]
+        {
+            if (!SetupExecutableRegionFor<num>(nds, cpu, instrAddr))
+            {
+                timestamp = target;
+                return;
+            }
+            offset = instrAddr - cpu.FastBlockLookupStart;
+        }
+
+        // LookUpBlock
+        const u64 entry = cpu.FastBlockLookup[offset / 2];
+        if (entry >> 32 == (instrAddr | num)) [[likely]]
+            ARM_Dispatch(&cpu, (JitBlockEntry)(rxBase + (u32)entry));
+        else
+            nds.JIT.CompileBlock(&cpu);
+
+        if (cpu.StopExecution)
+        {
+            // this order is crucial otherwise idle loops waiting for an IRQ won't function
+            if (cpu.IRQ)
+                cpu.TriggerIRQ();
+
+            if (cpu.Halted || cpu.IdleLoop)
+            {
+                if ((cpu.Halted == 1 || cpu.IdleLoop) && timestamp < target)
+                {
+                    cpu.Cycles = 0;
+                    timestamp = target;
+                }
+                cpu.IdleLoop = 0;
+
+                // Execute's end (only this way out can leave Halted set: StopExecution covers it)
+                if (cpu.Halted == 2)
+                    cpu.Halted = 0;
+
+                if (num == 1 && cpu.Halted == 4)
+                {
+                    assert(nds.ConsoleType == 1);
+                    auto& dsi = dynamic_cast<melonDS::DSi&>(nds);
+                    dsi.SoftReset();
+                    cpu.Halted = 2;
+                }
+                return;
+            }
+        }
+
+        timestamp += cpu.Cycles;
+        cpu.Cycles = 0;
+    }
+}
+
+// FastLoop (exact): RunFrame's loop for the JIT, slice for slice what it does with FastSched, with the common
+// cases inline: NextTarget, a running CPU's Execute (no call per slice; a halted one that nothing interrupts only
+// takes its time to the target, as Execute does), the timers (FastTimers), GPU3D::Run when the geometry engine is
+// idle, and RunSystem when no event is due.
+void NDS::RunSlicesJIT()
+{
+    // (melonDS's loop condition, Running && GPU.TotalScanlines==0: TotalScanlines changes only in an event, so it
+    // is checked after RunSystem)
+    if (GPU.TotalScanlines != 0)
+        return;
+
+    ARMv5& arm9 = *PinAddress(&ARM9);
+    ARMv4& arm7 = *PinAddress(&ARM7);
+    GPU3D& gpu3d = *PinAddress(&GPU.GPU3D);
+    char* const sb = PinAddress(reinterpret_cast<char*>(&SysTimestamp));
+    u8* const rxBase = JIT.JitRXBase;
+
+    // (CancelEvent's "to recompute", from outside RunFrame; inside, RunSystem resolves it)
+    if (SCHED(sb, SchedNext) == 0)
+        SchedNextUpdate();
+
+    // the loop over the ARM7 in RunFrame, from its first check on, with its timers: runARM7Busy from the first pass of
+    // its body on (the caller checked ARM7Timestamp < target)
+    // (clean: the caller saw no DMA7 bit in CPUStop and the ARM7 not halted, just before; nothing ran since)
+    auto runARM7Busy = [&](u64 target, bool clean = false) __attribute__((always_inline))
+    {
+        do
+        {
+            ARM7Target = target; // might be changed by a reschedule
+
+            if (!clean && (CPUStop & CPUStop_DMA7))
+            {
+                DMAs[4].Run();
+                DMAs[5].Run();
+                DMAs[6].Run();
+                DMAs[7].Run();
+                if (ConsoleType == 1)
+                {
+                    auto& dsi = dynamic_cast<melonDS::DSi&>(*this);
+                    dsi.RunNDMAs(1);
+                }
+            }
+            else if (clean || !arm7.Halted)
+                ExecuteJITInline<1>(*this, arm7, ARM7Timestamp, ARM7Target, rxBase);
+            else
+                arm7.Execute<CPUExecuteMode::JIT>();
+
+            if (ARM7Timestamp >= SCHED(sb, TimerNext[1]))
+                RunTimers(1);
+            clean = false;
+        } while (ARM7Timestamp < target);
+    };
+    auto runARM7 = [&](u64 target) __attribute__((always_inline))
+    {
+        if (ARM7Timestamp >= target)
+            return;
+
+        if (arm7.Halted == 1 && !(CPUStop & CPUStop_DMA7) && !HaltInterrupted(1))
+        {
+            // one pass of the loop: Execute takes ARM7Timestamp to ARM7Target, then the timers run
+            ARM7Target = target;
+            ARM7Timestamp = target;
+            if (target >= SCHED(sb, TimerNext[1]))
+                RunTimers(1);
+            return;
+        }
+
+        runARM7Busy(target);
+    };
+
+    // SysTimestamp and SchedNext as the last slice's end left them (only RunSystem sets SysTimestamp)
+    u64 sys = SCHED(sb, SysTimestamp);
+    u64 next = SCHED(sb, SchedNext);
+    while (SCHED(sb, Running))
+    {
+        // NextTarget(), FastSched
+        const s32 sliceShort = SCHED(sb, SliceShort), sliceIdle = SCHED(sb, SliceIdle);
+        const u64 max = sys + (sys < SCHED(sb, SliceNearIPCUntil) ? sliceShort : sliceIdle);
+        u64 target = (next < max + kIterationCycleMargin) ? next : max;
+
+        ARM9Target = target << ARM9ClockShift;
+        CurCPU = 0;
+
+        if (CPUStop & (CPUStop_GXStall | CPUStop_DMA9)) [[unlikely]]
+        {
+            if (CPUStop & CPUStop_GXStall)
+            {
+                // GXFIFO stall
+                s32 cycles = gpu3d.CyclesToRunFor();
+
+                ARM9Timestamp = std::min(ARM9Target, ARM9Timestamp+(cycles<<ARM9ClockShift));
+            }
+            else
+            {
+                DMAs[0].Run();
+                if (!(CPUStop & CPUStop_GXStall)) DMAs[1].Run();
+                if (!(CPUStop & CPUStop_GXStall)) DMAs[2].Run();
+                if (!(CPUStop & CPUStop_GXStall)) DMAs[3].Run();
+                if (ConsoleType == 1)
+                {
+                    auto& dsi = dynamic_cast<melonDS::DSi&>(*this);
+                    dsi.RunNDMAs(0);
+                }
+            }
+        }
+        else if (!arm9.Halted) [[likely]]
+            ExecuteJITInline<0>(*this, arm9, ARM9Timestamp, ARM9Target, rxBase);
+        else if (arm9.Halted == 1 && !HaltInterrupted(0))
+            ARM9Timestamp = ARM9Target;
+        else
+            arm9.Execute<CPUExecuteMode::JIT>();
+
+        target = ARM9Timestamp >> ARM9ClockShift;
+
+        // GPU3D::Run's early-out (the same condition, its cheapest part first)
+        const bool gpuIdle = (gpu3d.CmdPIPE.IsEmpty() && !(gpu3d.GXStat & (1<<27))) || !gpu3d.GeometryEnabled ||
+            gpu3d.FlushRequest;
+        u32 stop;
+        if (target < SCHED(sb, TimerNextMin) && gpuIdle) [[likely]]
+        {
+            // no timer due on either CPU by the ARM9's time, which is as far as the ARM7 goes (RunTimers(0) and
+            // RunTimers(1) wouldn't be called), and nothing for the geometry engine to do
+            gpu3d.Timestamp = target;
+            CurCPU = 1;
+            // (CPUStop read once for the ARM7's DMA and the sleep check below, when nothing runs in between)
+            stop = CPUStop;
+            if (ARM7Timestamp < target)
+            {
+                const u8 halted7 = arm7.Halted;
+                if (halted7 == 1 && !(stop & CPUStop_DMA7) && !HaltInterrupted(1))
+                {
+                    ARM7Target = target;
+                    ARM7Timestamp = target;
+                }
+                else
+                {
+                    runARM7Busy(target, halted7 == 0 && !(stop & CPUStop_DMA7));
+                    stop = CPUStop;
+                }
+            }
+        }
+        else
+        {
+            // (the ARM9's time is read again after a call, as melonDS's loop does)
+            if (target >= SCHED(sb, TimerNext[0]))
+            {
+                RunTimers(0);
+                target = ARM9Timestamp >> ARM9ClockShift;
+            }
+
+            if ((gpu3d.CmdPIPE.IsEmpty() && !(gpu3d.GXStat & (1<<27))) || !gpu3d.GeometryEnabled || gpu3d.FlushRequest)
+                gpu3d.Timestamp = target;
+            else
+            {
+                gpu3d.Run();
+                target = ARM9Timestamp >> ARM9ClockShift;
+            }
+
+            CurCPU = 1;
+            runARM7(target);
+            stop = CPUStop;
+        }
+
+        // RunSystem(target), FastSched
+        SCHED(sb, SysTimestamp) = target;
+        sys = target;
+        next = SCHED(sb, SchedNext);
+        if (target >= next)
+        {
+            RunEventsDue(sb);
+            if (GPU.TotalScanlines != 0)
+                break;
+            stop = CPUStop;
+            next = SCHED(sb, SchedNext);
+        }
+
+        if (stop & CPUStop_Sleep)
+            break;
+    }
+}
+#endif
+
