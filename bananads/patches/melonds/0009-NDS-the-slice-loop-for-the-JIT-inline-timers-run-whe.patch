 {
 #ifdef JIT_ENABLED
@@ -1140,7 +1419,8 @@ u32 NDS::RunFrame()
     }
 }
 
-void NDS::Reschedule(u64 target)
+// (inline: ScheduleEvent is its only caller)
+[[gnu::always_inline]] inline void NDS::Reschedule(u64 target)
 {
     if (CurCPU == 0)
     {
@@ -1208,10 +1488,12 @@ void NDS::ScheduleEvent(u32 id, bool periodic, s32 delay, u32 funcid, u32 param)
 
 void NDS::CancelEvent(u32 id)
 {
-    const bool wasnext = (SchedListMask & (1<<id)) && SchedList[id].Timestamp == SchedNext;
+    // FastSched: cancelling the event SchedNext holds sets it to 0, "to recompute" (often a new one follows: the
+    // divider and sqrt unit cancel and reschedule theirs on every parameter write). The next RunSystem walks the
+    // list, firing only what is due as always, and rebuilds it; NextTarget recomputes it if it comes first.
+    if ((SchedListMask & (1<<id)) && SchedList[id].Timestamp == SchedNext)
+        SchedNext = 0;
     SchedListMask &= ~(1<<id);
-    if (FastSched && wasnext)
-        SchedNextUpdate();
 }
 
 
@@ -1746,6 +2028,31 @@ void NDS::RunTimers(u32 cpu)
     if (timermask & 0x8) RunTimer((cpu<<2)+3, cycles);
 
     TimerTimestamp[cpu] += cycles;
+
+    if (FastTimers)
+        TimerNextUpdate(cpu);
+}
+
+void NDS::TimerNextUpdate(u32 cpu) noexcept
+{
+    // RunTimers' cycles is an s32: run at least every 2^30 cycles
+    const u64 base = TimerTimestamp[cpu];
+    u64 next = base + (1u << 30);
+    const u32 mask = TimerCheckMask[cpu];
+    for (u32 i = 0; i < 4; i++)
+    {
+        if (!(mask & (1 << i)))
+            continue;
+
+        // RunTimer adds cycles << CycleShift to Counter and overflows at 1 << 26
+        const Timer& timer = Timers[(cpu << 2) + i];
+        u64 due = base;
+        if (timer.Counter < (1u << 26))
+            due += (((1u << 26) - timer.Counter) + (1u << timer.CycleShift) - 1) >> timer.CycleShift;
+        if (due < next)
+            next = due;
+    }
+    TimerNext[cpu] = next;
 }
 
 const s32 TimerPrescaler[4] = {0, 6, 8, 10};
@@ -1778,6 +2085,9 @@ void NDS::TimerStart(u32 id, u16 cnt)
         TimerCheckMask[id>>2] |= 0x01 << (id&0x3);
     else
         TimerCheckMask[id>>2] &= ~(0x01 << (id&0x3));
+
+    if (FastTimers)
+        TimerNextUpdate(id>>2);
 }
 
 
