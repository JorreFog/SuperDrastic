+#ifdef JIT_ENABLED
+// ARMv5/ARMv4::Execute<JIT>'s block loop and its end, for a CPU that isn't halted (FastLoop)
+template <u32 num, typename CPU>
+[[gnu::always_inline]] static inline void ExecuteJITInline(NDS& nds, CPU& cpu, u64& timestamp, u64& target)
+{
+    while (timestamp < target)
+    {
+        u32 instrAddr = cpu.R[15] - ((cpu.CPSR&0x20)?2:4);
+
+        if ((instrAddr < cpu.FastBlockLookupStart || instrAddr >= (cpu.FastBlockLookupStart + cpu.FastBlockLookupSize))
+            && !nds.JIT.SetupExecutableRegion(num, instrAddr, cpu.FastBlockLookup, cpu.FastBlockLookupStart, cpu.FastBlockLookupSize))
+        {
+            timestamp = target;
+            Log(LogLevel::Error, num ? "ARMv4 PC in non executable region %08X\n" : "ARMv5 PC in non executable region %08X\n", cpu.R[15]);
+            return;
+        }
+
+        JitBlockEntry block = nds.JIT.LookUpBlock(num, cpu.FastBlockLookup,
+            instrAddr - cpu.FastBlockLookupStart, instrAddr);
+        if (block)
+            ARM_Dispatch(&cpu, block);
+        else
+            nds.JIT.CompileBlock(&cpu);
+
+        if (cpu.StopExecution)
+        {
+            // this order is crucial otherwise idle loops waiting for an IRQ won't function
+            if (cpu.IRQ)
+                cpu.TriggerIRQ();
+
+            if (cpu.Halted || cpu.IdleLoop)
+            {
+                if ((cpu.Halted == 1 || cpu.IdleLoop) && timestamp < target)
+                {
+                    cpu.Cycles = 0;
+                    timestamp = target;
+                }
+                cpu.IdleLoop = 0;
+                break;
+            }
+        }
+
+        timestamp += cpu.Cycles;
+        cpu.Cycles = 0;
+    }
+
+    if (cpu.Halted) [[unlikely]]
+    {
+        if (cpu.Halted == 2)
+            cpu.Halted = 0;
+
+        if (num == 1 && cpu.Halted == 4)
+        {
+            assert(nds.ConsoleType == 1);
+            auto& dsi = dynamic_cast<melonDS::DSi&>(nds);
+            dsi.SoftReset();
+            cpu.Halted = 2;
+        }
+    }
+}
+
+// FastLoop's base registers: an address the loop keeps in a register, instead of GCC rebuilding the address of a
+// member far into the NDS object (mov/movk/add) at every use
+template <typename T>
+[[gnu::always_inline]] static inline T* PinAddress(T* p)
+{
+    asm("" : "+r"(p));
+    return p;
+}
+
+// FastLoop (exact): RunFrame's loop for the JIT, slice for slice what it does with FastSched, with the common
+// cases inline: NextTarget, a running CPU's Execute (no call per slice; a halted one that nothing interrupts only
+// takes its time to the target, as Execute does), the timers (FastTimers), GPU3D::Run when the geometry engine is
+// idle, and RunSystem when no event is due.
+void NDS::RunSlicesJIT()
+{
+    // (melonDS's loop condition, Running && GPU.TotalScanlines==0: TotalScanlines changes only in an event, so it
+    // is checked after RunSystem)
+    if (GPU.TotalScanlines != 0)
+        return;
+
+    ARMv5& arm9 = *PinAddress(&ARM9);
+    ARMv4& arm7 = *PinAddress(&ARM7);
+    GPU3D& gpu3d = *PinAddress(&GPU.GPU3D);
+    // the scheduler's members, which sit together: through one base register
+    char* const sched = PinAddress(reinterpret_cast<char*>(&SysTimestamp));
+    auto S = [sched, this](auto& member) -> auto&
+    {
+        using T = std::remove_reference_t<decltype(member)>;
+        return *reinterpret_cast<T*>(sched + (reinterpret_cast<uintptr_t>(&member) - reinterpret_cast<uintptr_t>(&SysTimestamp)));
+    };
+
+    // (CancelEvent's "to recompute", from outside RunFrame; inside, RunSystem resolves it)
+    if (S(SchedNext) == 0)
+        SchedNextUpdate();
+
+    while (S(Running))
+    {
+        // NextTarget(), FastSched
+        const u64 sys = S(SysTimestamp);
+        const u64 max = sys + (sys < S(SliceNearIPCUntil) ? S(SliceShort) : S(SliceIdle));
+        const u64 next = S(SchedNext);
+        u64 target = (next < max + kIterationCycleMargin) ? next : max;
+
+        ARM9Target = target << ARM9ClockShift;
+        CurCPU = 0;
+
+        if (CPUStop & (CPUStop_GXStall | CPUStop_DMA9)) [[unlikely]]
+        {
+            if (CPUStop & CPUStop_GXStall)
+            {
+                // GXFIFO stall
+                s32 cycles = gpu3d.CyclesToRunFor();
+
+                ARM9Timestamp = std::min(ARM9Target, ARM9Timestamp+(cycles<<ARM9ClockShift));
+            }
+            else
+            {
+                DMAs[0].Run();
+                if (!(CPUStop & CPUStop_GXStall)) DMAs[1].Run();
+                if (!(CPUStop & CPUStop_GXStall)) DMAs[2].Run();
+                if (!(CPUStop & CPUStop_GXStall)) DMAs[3].Run();
+                if (ConsoleType == 1)
+                {
+                    auto& dsi = dynamic_cast<melonDS::DSi&>(*this);
+                    dsi.RunNDMAs(0);
+                }
+            }
+        }
+        else if (!arm9.Halted) [[likely]]
+            ExecuteJITInline<0>(*this, arm9, ARM9Timestamp, ARM9Target);
+        else if (arm9.Halted == 1 && !HaltInterrupted(0))
+            ARM9Timestamp = ARM9Target;
+        else
+            arm9.Execute<CPUExecuteMode::JIT>();
+
+        // (the ARM9's time is read again after a call, as melonDS's loop does)
+        target = ARM9Timestamp >> ARM9ClockShift;
+        if (target >= S(TimerNext[0]))
+        {
+            RunTimers(0);
+            target = ARM9Timestamp >> ARM9ClockShift;
+        }
+
+        // GPU3D::Run's early-out (the same condition, its cheapest part first)
+        if ((gpu3d.CmdPIPE.IsEmpty() && !(gpu3d.GXStat & (1<<27))) || !gpu3d.GeometryEnabled || gpu3d.FlushRequest)
+            gpu3d.Timestamp = target;
+        else
+        {
+            gpu3d.Run();
+            target = ARM9Timestamp >> ARM9ClockShift;
+        }
+
+        CurCPU = 1;
+
+        if (ARM7Timestamp < target)
+        {
+            if (arm7.Halted == 1 && !(CPUStop & CPUStop_DMA7) && !HaltInterrupted(1))
+            {
+                // one pass of the loop below: Execute takes ARM7Timestamp to ARM7Target, then the timers run
+                ARM7Target = target;
+                ARM7Timestamp = target;
+                if (target >= S(TimerNext[1]))
+                    RunTimers(1);
+            }
+            else
+            {
+                do
+                {
+                    ARM7Target = target; // might be changed by a reschedule
+
+                    if (CPUStop & CPUStop_DMA7)
+                    {
+                        DMAs[4].Run();
+                        DMAs[5].Run();
+                        DMAs[6].Run();
+                        DMAs[7].Run();
+                        if (ConsoleType == 1)
+                        {
+                            auto& dsi = dynamic_cast<melonDS::DSi&>(*this);
+                            dsi.RunNDMAs(1);
+                        }
+                    }
+                    else if (!arm7.Halted)
+                        ExecuteJITInline<1>(*this, arm7, ARM7Timestamp, ARM7Target);
+                    else
+                        arm7.Execute<CPUExecuteMode::JIT>();
+
+                    if (ARM7Timestamp >= S(TimerNext[1]))
+                        RunTimers(1);
+                } while (ARM7Timestamp < target);
+            }
+        }
+
+        // RunSystem(target), FastSched
+        S(SysTimestamp) = target;
+        if (target >= S(SchedNext))
+        {
+            RunEventsDue();
+            if (GPU.TotalScanlines != 0)
+                break;
+        }
+
+        if (CPUStop & CPUStop_Sleep)
+            break;
+    }
+}
+#endif
+
