+}
+
+void NDS::TimerNextUpdate(u32 cpu) noexcept
+{
+    // RunTimers' cycles is an s32: run at least every 2^30 cycles
+    const u64 base = TimerTimestamp[cpu];
+    u64 next = base + (1u << 30);
+    const u32 mask = TimerCheckMask[cpu];
+    for (u32 i = 0; i < 4; i++)
+    {
+        if (!(mask & (1 << i)))
+            continue;
+
+        // RunTimer adds cycles << CycleShift to Counter and overflows at 1 << 26
+        const Timer& timer = Timers[(cpu << 2) + i];
+        u64 due = base;
+        if (timer.Counter < (1u << 26))
+            due += (((1u << 26) - timer.Counter) + (1u << timer.CycleShift) - 1) >> timer.CycleShift;
