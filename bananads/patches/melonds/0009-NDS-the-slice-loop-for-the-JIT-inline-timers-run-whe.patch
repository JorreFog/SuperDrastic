+// RunSystem's walk with FastSched, once SysTimestamp has reached SchedNext: over the set bits only, the same events
+// in the same order (from the same snapshot of the mask), each checked as it's reached. SchedNext is rebuilt on the
+// way: the events still pending as they're passed, and what the handlers schedule (ScheduleEvent takes the min); a
+// handler's CancelEvent of the event SchedNext holds so far sets it to 0, which the end resolves. (Inline: RunSystem
+// and RunSlicesJIT.)
+[[gnu::always_inline]] inline void NDS::RunEventsDue(char* const sb) noexcept
+{
+    u64 next = UINT64_MAX;
+    u32 live = SCHED(sb, SchedListMask);
+    for (u32 mask = live; mask; mask &= mask - 1)
+    {
+        const u32 i = __builtin_ctz(mask);
+        SchedEvent& evt = SchedList[i];
+
+        if (evt.Timestamp <= SCHED(sb, SysTimestamp))
+        {
+            SCHED(sb, SchedListMask) &= ~(1<<i);
+
+            SCHED(sb, SchedNext) = next;
+            EventFunc func = evt.Funcs[evt.FuncID];
+            func(evt.That, evt.Param);
+            next = SCHED(sb, SchedNext);
+            live = SCHED(sb, SchedListMask);
+        }
+        else if ((live & (1<<i)) && evt.Timestamp < next)
+            next = evt.Timestamp;
+    }
+    SCHED(sb, SchedNext) = next;
+
+    // a recompute inside the walk may have taken an event the walk fired after it (one due by now)
+    if (next <= SCHED(sb, SysTimestamp))
+        SchedNextUpdate();
+#ifndef NDEBUG
+    const u64 built = SchedNext;
+    SchedNextUpdate();
+    assert(SchedNext == built);
+#endif
+}
