+// An address kept in a register, instead of GCC rebuilding the address of a member far into the NDS object
+// (mov/movk/add, past main RAM) at every use.
+template <typename T>
+[[gnu::always_inline]] static inline T* PinAddress(T* p)
+{
+    asm("" : "+r"(p));
+    return p;
+}
+// The scheduler's members sit together: SCHED(sb, m) is member m through sb = PinAddress(&SysTimestamp).
+#define SCHED(sb, m) (*reinterpret_cast<std::remove_reference_t<decltype(m)>*>((sb) + \
+    (reinterpret_cast<uintptr_t>(&(m)) - reinterpret_cast<uintptr_t>(&SysTimestamp))))
