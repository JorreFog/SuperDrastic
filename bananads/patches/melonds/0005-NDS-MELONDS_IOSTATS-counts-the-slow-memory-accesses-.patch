 {
     addr &= ~(sizeof(T) - 1);
 
@@ -177,16 +300,62 @@ void SlowWrite7(u32 addr, u32 val)
         NDS::Current->ARM7Write8(addr, val);
 }
 
+template <typename T, int ConsoleType>
