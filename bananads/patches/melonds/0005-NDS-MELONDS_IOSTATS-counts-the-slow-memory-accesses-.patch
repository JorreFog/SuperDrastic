+namespace melonDS
+{
+
+static u32 IOStatsFrom = 0;
+
+static u32 ReadIOStatsEnv()
+{
+    const char* e = getenv("MELONDS_IOSTATS");
+    const long v = e ? strtol(e, nullptr, 0) : 0;
+    return v > 0 ? (u32)v : 0;
+}
+
+bool IOStatsOn = (IOStatsFrom = ReadIOStatsEnv()) != 0;
+static u32 ReadIOFastEnv()
+{
+    const char* e = getenv("MELONDS_IOFAST");
+    if (e && e[0] == '0')
+        return 0;
+    const char* r = getenv("MELONDS_IOFAST_ROUTES");
+    return r ? (u32)strtoul(r, nullptr, 0) & 0xF : 0xF;
+}
+
+u32 IOFastRoutes = ReadIOFastEnv();
+bool IOFastOn = IOFastRoutes != 0;
+
+void IOFastInit() noexcept
+{
+    IOFastRoutes = ReadIOFastEnv();
+    IOFastOn = IOFastRoutes != 0;
+}
