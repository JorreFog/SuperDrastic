+// IO statistics and the JIT slow paths' direct routes.
+//
+// MELONDS_IOSTATS=n counts, from frame n on, the memory accesses that leave the JIT's fast paths (SlowRead/
+// SlowWrite and SlowBlockTransfer, per CPU, by address: IO registers exactly, other memory by region) and every
+// IO register access (NDS::ARM9IO* / ARM7IO*, whoever makes it: JIT, interpreter or DMA), and prints the top
+// entries to stderr at exit. Off, each counting site costs one predicted-not-taken branch.
+//
+// MELONDS_IOFAST=0 turns off the direct routes (MELONDS_IOFAST_ROUTES=mask keeps only some, iofast_* below) the JIT's slow paths take for the hottest addresses (ARMJIT.cpp,
+// ARMJIT_Memory.cpp). Each route does what the NDS::ARM9Read/Write chain does for that address, minus the
+// dispatch; the JIT charges a slow access's cycles in the compiled code, so no timing changes either way.
+
+#ifndef NDS_IOFAST_H
+#define NDS_IOFAST_H
+
+#include "types.h"
+
+namespace melonDS
+{
+
+enum
+{
+    iostat_Read9,       // ARM9 SlowRead* (by address size)
+    iostat_Write9,      // ARM9 SlowWrite*
+    iostat_Read7,
+    iostat_Write7,
+    iostat_Block9Read,  // ARM9 SlowBlockTransfer, LDM (by the first word's address)
+    iostat_Block9Write, // ARM9 SlowBlockTransfer, STM
+    iostat_Block7Read,
+    iostat_Block7Write,
+    iostat_IORead9,     // ARM9 IO register read, any caller
+    iostat_IOWrite9,
+    iostat_IORead7,
+    iostat_IOWrite7,
+    iostat_Count
+};
+
+// the routes MELONDS_IOFAST_ROUTES picks (a mask, default all), for A/B runs of one route at a time
+enum
+{
+    iofast_MainRAM = 1,     // main RAM reads and writes (LDM/STM, pages holding compiled code)
+    iofast_VRAM = 2,        // VRAM 16- and 32-bit reads and writes
+    iofast_GX = 4,          // the GX FIFO and command ports, 32-bit writes
+    iofast_IORead = 8,      // DISPSTAT/VCOUNT, KEYINPUT, IME/IE/IF reads
+};
+
+extern bool IOStatsOn;
+extern bool IOFastOn;       // MELONDS_IOFAST isn't 0 and the mask isn't empty
+extern u32 IOFastRoutes;
+
+// counts one access of `size` bytes (or a block of `words` words) at addr; only called when IOStatsOn
+void IOStatsCount(int kind, u32 addr, u32 size, u32 words) noexcept;
+// (re)reads MELONDS_IOFAST and MELONDS_IOFAST_ROUTES; ARMJIT::Reset calls it, so a front-end can set it per console
+void IOFastInit() noexcept;
+
+#define MELONDS_IOSTAT(kind, addr, size, words) \
+    do { if (__builtin_expect(IOStatsOn, 0)) IOStatsCount(kind, addr, size, words); } while (0)
+
+}
+
+#endif
