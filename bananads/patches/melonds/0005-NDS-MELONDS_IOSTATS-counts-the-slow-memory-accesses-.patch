 template <bool Write, int ConsoleType>
 void SlowBlockTransfer9(u32 addr, u64* data, u32 num, ARMv5* cpu)
 {
     addr &= ~0x3;
+    MELONDS_IOSTAT(Write ? iostat_Block9Write : iostat_Block9Read, addr, 4, num);
+    if (ConsoleType == 0 && IOFastOn)
+    {
+        // the same per word as SlowWrite9/SlowRead9 (the TCMs first), with the direct routes
+        melonDS::NDS& nds = cpu->NDS;
+        for (u32 i = 0; i < num; i++, addr += 4)
+        {
+            if (addr < cpu->ITCMSize)
+            {
+                if (Write)
+                {
+                    nds.JIT.CheckAndInvalidate<0, ARMJIT_Memory::memregion_ITCM>(addr);
+                    *(u32*)&cpu->ITCM[addr & 0x7FFF] = data[i];
+                }
+                else
+                    data[i] = *(u32*)&cpu->ITCM[addr & 0x7FFF];
+            }
+            else if ((addr & cpu->DTCMMask) == cpu->DTCMBase)
+            {
+                if (Write)
+                    *(u32*)&cpu->DTCM[addr & 0x3FFF] = data[i];
+                else
+                    data[i] = *(u32*)&cpu->DTCM[addr & 0x3FFF];
+            }
+            else if (Write)
+            {
+                if (!IOFastWrite9<u32>(nds, addr, (u32)data[i]))
+                    nds.ARM9Write32(addr, data[i]);
+            }
+            else
+            {
+                u32 val;
+                if (!IOFastRead9<u32>(nds, addr, val))
+                    val = nds.ARM9Read32(addr);
+                data[i] = val;
+            }
+        }
+        return;
+    }
     for (u32 i = 0; i < num; i++)
     {
         if (Write)
-            SlowWrite9<u32, ConsoleType>(addr, cpu, data[i]);
+            SlowWrite9Impl<u32, ConsoleType>(addr, cpu, data[i]);
         else
-            data[i] = SlowRead9<u32, ConsoleType>(addr, cpu);
+            data[i] = SlowRead9Impl<u32, ConsoleType>(addr, cpu);
         addr += 4;
     }
 }
@@ -195,12 +364,13 @@ template <bool Write, int ConsoleType>
 void SlowBlockTransfer7(u32 addr, u64* data, u32 num)
 {
     addr &= ~0x3;
+    MELONDS_IOSTAT(Write ? iostat_Block7Write : iostat_Block7Read, addr, 4, num);
     for (u32 i = 0; i < num; i++)
     {
         if (Write)
-            SlowWrite7<u32, ConsoleType>(addr, data[i]);
+            SlowWrite7Impl<u32, ConsoleType>(addr, data[i]);
         else
-            data[i] = SlowRead7<u32, ConsoleType>(addr);
+            data[i] = SlowRead7Impl<u32, ConsoleType>(addr);
         addr += 4;
     }
 }
@@ -238,6 +408,7 @@ ARMJIT::~ARMJIT() noexcept
 
 void ARMJIT::Reset() noexcept
 {
+    IOFastInit();
     JitEnableWrite();
     ResetBlockCache();
 
