+    ~Stats() { Print(); }
+
+    void Print()
+    {
+        if (!IOStatsOn || Table.empty())
+            return;
+
+        static const char* const names[iostat_Count] = {
+            "ARM9 JIT slow read",  "ARM9 JIT slow write",  "ARM7 JIT slow read", "ARM7 JIT slow write",
+            "ARM9 JIT block read (LDM)", "ARM9 JIT block write (STM)",
+            "ARM7 JIT block read (LDM)", "ARM7 JIT block write (STM)",
+            "ARM9 IO register read (all callers)", "ARM9 IO register write (all callers)",
+            "ARM7 IO register read (all callers)", "ARM7 IO register write (all callers)",
+        };
+        const u32 frames = LastFrame >= FirstFrame ? LastFrame - FirstFrame + 1 : 1;
+        fprintf(stderr, "melonDS IO stats: frames %u-%u (%u); per kind: total, then the top entries"
+            " (calls; words for blocks; per frame)\n", FirstFrame, LastFrame, frames);
+
+        for (int kind = 0; kind < iostat_Count; kind++)
+        {
+            std::vector<std::pair<u64, Counts>> rows;
+            u64 calls = 0, words = 0;
+            for (auto& it : Table)
+            {
+                if ((int)(it.first >> 40) != kind)
+                    continue;
+                rows.push_back(it);
+                calls += it.second.Calls;
+                words += it.second.Words;
+            }
+            if (rows.empty())
+                continue;
+            std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b)
+                { return a.second.Calls != b.second.Calls ? a.second.Calls > b.second.Calls : a.first < b.first; });
+
+            const bool block = kind >= iostat_Block9Read && kind <= iostat_Block7Write;
+            fprintf(stderr, "  %s: %llu calls (%.1f/frame)", names[kind], (unsigned long long)calls,
+                (double)calls / frames);
+            if (block)
+                fprintf(stderr, ", %llu words (%.1f/frame)", (unsigned long long)words, (double)words / frames);
+            fprintf(stderr, "\n");
+
+            for (size_t i = 0; i < rows.size() && i < 16; i++)
+            {
+                const u32 where = (u32)rows[i].first;
+                const u32 size = (rows[i].first >> 32) & 0xFF;
+                char label[32];
+                if (where == 1)
+                    snprintf(label, sizeof(label), "ITCM");
+                else if (where == 2)
+                    snprintf(label, sizeof(label), "DTCM");
+                else if ((where >> 24) == 0x04)
+                    snprintf(label, sizeof(label), "%08X", where);
+                else
+                    snprintf(label, sizeof(label), "%08X region", where);
+                fprintf(stderr, "    %-16s %2u-bit %12llu (%9.1f/frame)", label, size * 8,
+                    (unsigned long long)rows[i].second.Calls, (double)rows[i].second.Calls / frames);
+                if (block)
+                    fprintf(stderr, " words %12llu", (unsigned long long)rows[i].second.Words);
+                fprintf(stderr, "\n");
+            }
+        }
+    }
+};
+
+Stats IOStatsTable;
+
+}
+
+void IOStatsCount(int kind, u32 addr, u32 size, u32 words) noexcept
+{
+    NDS* nds = NDS::Current;
+    if (!nds)
+        return;
+    const u32 frame = nds->NumFrames;
+    if (frame < IOStatsFrom)
+        return;
+    IOStatsTable.FirstFrame = std::min(IOStatsTable.FirstFrame, frame);
+    IOStatsTable.LastFrame = std::max(IOStatsTable.LastFrame, frame);
+
+    u32 where = addr;
+    if (kind < iostat_IORead9)
+    {
+        const bool arm9 = kind == iostat_Read9 || kind == iostat_Write9
+            || kind == iostat_Block9Read || kind == iostat_Block9Write;
+        if (arm9 && addr < nds->ARM9.ITCMSize)
+            where = 1;
+        else if (arm9 && (addr & nds->ARM9.DTCMMask) == nds->ARM9.DTCMBase)
+            where = 2;
+        else if ((addr >> 24) != 0x04)
+            where = addr & (arm9 ? 0xFF000000 : 0xFF800000);
+    }
+
+    Counts& c = IOStatsTable.Table[((u64)kind << 40) | ((u64)size << 32) | where];
+    c.Calls++;
+    c.Words += words;
+}
+
+}
