+// The direct routes (MELONDS_IOFAST, NDS_IOFast.h): for the addresses below (main RAM, VRAM, the GX FIFO and
+// command ports, and the IRQ, DISPSTAT/VCOUNT and KEYINPUT registers), what NDS::ARM9Read*/ARM9Write* and
+// ARM9IORead*/ARM9IOWrite* would do, line for line, without the virtual calls and the switches. Only for the DS
+// (ConsoleType 0): the DSi overrides those functions. The callers have already ruled out the TCMs, as the chain
+// does.
+template <typename T>
+static inline bool IOFastRead9(melonDS::NDS& nds, u32 addr, T& val)
+{
+    const u32 routes = IOFastRoutes;
+    if ((routes & iofast_MainRAM) && (addr >> 24) == 0x02)
+    {
+        val = *(T*)&nds.MainRAM[addr & nds.MainRAMMask];
+        return true;
+    }
+    if (sizeof(T) >= 2 && (routes & iofast_VRAM) && (addr >> 24) == 0x06)
+    {
+        melonDS::GPU& gpu = nds.GPU;
+        switch (addr & 0x00E00000)
+        {
+        case 0x00000000: gpu.SyncVRAM_ABG(addr, false); val = gpu.ReadVRAM_ABG<T>(addr); return true;
+        case 0x00200000: gpu.SyncVRAM_BBG(addr, false); val = gpu.ReadVRAM_BBG<T>(addr); return true;
+        case 0x00400000: gpu.SyncVRAM_AOBJ(addr, false); val = gpu.ReadVRAM_AOBJ<T>(addr); return true;
+        case 0x00600000: gpu.SyncVRAM_BOBJ(addr, false); val = gpu.ReadVRAM_BOBJ<T>(addr); return true;
+        default:         gpu.SyncVRAM_LCDC(addr, false); val = gpu.ReadVRAM_LCDC<T>(addr); return true;
+        }
+    }
+    if (!(routes & iofast_IORead))
+        return false;
+    if (sizeof(T) == 4)
+    {
+        switch (addr)
+        {
+        case 0x04000004: val = nds.GPU.DispStat[0] | (nds.GPU.VCount << 16); return true;
+        case 0x04000208: val = nds.IME[0]; return true;
+        case 0x04000210: val = nds.IE[0]; return true;
+        case 0x04000214: val = nds.IF[0]; return true;
+        }
+    }
+    else if (sizeof(T) == 2)
+    {
+        switch (addr)
+        {
+        case 0x04000004: val = nds.GPU.DispStat[0]; return true;
+        case 0x04000006: val = nds.GPU.VCount; return true;
+        case 0x04000130: nds.LagFrameFlag = false; val = nds.KeyInput & 0xFFFF; return true;
+        case 0x04000208: val = nds.IME[0]; return true;
+        case 0x04000210: val = nds.IE[0] & 0xFFFF; return true;
+        case 0x04000212: val = nds.IE[0] >> 16; return true;
+        case 0x04000214: val = nds.IF[0] & 0xFFFF; return true;
+        case 0x04000216: val = nds.IF[0] >> 16; return true;
+        }
+    }
+    return false;
+}
+
+template <typename T>
+static inline bool IOFastWrite9(melonDS::NDS& nds, u32 addr, u32 val)
+{
+    const u32 routes = IOFastRoutes;
+    if ((routes & iofast_MainRAM) && (addr >> 24) == 0x02)
+    {
+        nds.JIT.CheckAndInvalidate<0, ARMJIT_Memory::memregion_MainRAM>(addr);
+        *(T*)&nds.MainRAM[addr & nds.MainRAMMask] = val;
+        return true;
+    }
+    if (sizeof(T) >= 2 && (routes & iofast_VRAM) && (addr >> 24) == 0x06)
+    {
+        nds.JIT.CheckAndInvalidate<0, ARMJIT_Memory::memregion_VRAM>(addr);
+        melonDS::GPU& gpu = nds.GPU;
+        switch (addr & 0x00E00000)
+        {
+        case 0x00000000: gpu.SyncVRAM_ABG(addr, true); gpu.WriteVRAM_ABG<T>(addr, val); return true;
+        case 0x00200000: gpu.SyncVRAM_BBG(addr, true); gpu.WriteVRAM_BBG<T>(addr, val); return true;
+        case 0x00400000: gpu.SyncVRAM_AOBJ(addr, true); gpu.WriteVRAM_AOBJ<T>(addr, val); return true;
+        case 0x00600000: gpu.SyncVRAM_BOBJ(addr, true); gpu.WriteVRAM_BOBJ<T>(addr, val); return true;
+        default:         gpu.SyncVRAM_LCDC(addr, true); gpu.WriteVRAM_LCDC<T>(addr, val); return true;
+        }
+    }
+    // the geometry engine's FIFO (0x04000400-43F) and command ports (0x04000440-5FF): ARM9IOWrite32 hands
+    // these to GPU3D::Write32, which drops them while the geometry engine is off and gives the FIFO port to
+    // WriteToGXFIFO
+    if (sizeof(T) == 4 && (routes & iofast_GX) && addr - 0x04000400 < 0x200)
+    {
+        GPU3D& gpu3d = nds.GPU.GPU3D;
+        if (addr < 0x04000440)
+        {
+            if (gpu3d.GeometryEnabled)
+                gpu3d.WriteToGXFIFO(val);
+        }
+        else
+            gpu3d.Write32(addr, val);
+        return true;
+    }
+    return false;
+}
