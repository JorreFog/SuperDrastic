 src/GPU3D.cpp      | 181 +++++++++++++++++++++++++--------------------
 src/GPU3D.h        |   9 +++
 src/NDS_IOFast.cpp |  13 +++-
 src/NDS_IOFast.h   |   1 +
 5 files changed, 147 insertions(+), 84 deletions(-)

diff --git a/src/ARMJIT.cpp b/src/ARMJIT.cpp
index 8b6a68f..1ab0413 100644
--- a/src/ARMJIT.cpp
+++ b/src/ARMJIT.cpp
@@ -585,8 +585,35 @@ void SlowWrite7(u32 addr, u32 val)
     SlowWrite7Impl<T, ConsoleType>(addr, val);
 }
 
+template <bool Write, int ConsoleType>
+[[gnu::noinline]] static void SlowBlockTransfer9Body(u32 addr, u64* data, u32 num, ARMv5* cpu);
+
 template <bool Write, int ConsoleType>
 void SlowBlockTransfer9(u32 addr, u64* data, u32 num, ARMv5* cpu)
+{
+    if (ConsoleType == 0 && Write)
+    {
+        // render.gx_batch: an STM into the GX FIFO, checked first and handed to the geometry engine in one call
+        // (the block path below with the same checks: the GX route on, clear of the TCMs, all of it in
+        // 0x04000400-0x0400043F; GeometryEnabled can't change in between); not with the IO statistics on
+        const u32 flags = SlowPathFlags;
+        const u32 a = addr & ~0x3u;
+        constexpr u32 need = slow_GXBatch | slow_MemIO | iofast_GX;
+        if ((flags & (need | slow_FullPath)) == need && a - 0x04000400 < 0x40 && num
+            && a + (num - 1) * 4 < 0x04000440 && a >= cpu->ITCMSize && (~cpu->DTCMMask) >= 0x3FF
+            && (a & cpu->DTCMMask) != cpu->DTCMBase)
+        {
+            GPU3D& gpu3d = cpu->NDS.GPU.GPU3D;
+            if (gpu3d.GeometryEnabled)
+                gpu3d.WriteGXFIFOWords(data, num);
+            return;
+        }
+    }
+    SlowBlockTransfer9Body<Write, ConsoleType>(addr, data, num, cpu);
+}
+
+template <bool Write, int ConsoleType>
+[[gnu::noinline]] static void SlowBlockTransfer9Body(u32 addr, u64* data, u32 num, ARMv5* cpu)
 {
     addr &= ~0x3;
     MELONDS_IOSTAT(Write ? iostat_Block9Write : iostat_Block9Read, addr, 4, num);
