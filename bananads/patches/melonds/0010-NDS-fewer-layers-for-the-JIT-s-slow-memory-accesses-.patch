+    // the ARM7's: ARM7IORead16/32 for IPCSYNC, IPCFIFOCNT, the IPC receive FIFO and IME/IE/IF
+    template <typename T>
+    bool ARM7IOReadDirect(u32 addr, T& val) noexcept
+    {
+        if (sizeof(T) == 2)
+        {
+            switch (addr)
+            {
+            case 0x04000180: SliceIPC(1); val = IPCSync7; return true;
+            case 0x04000184: SliceIPC(1);
+                {
+                    u16 v = IPCFIFOCnt7;
+                    if (IPCFIFO7.IsEmpty())     v |= 0x0001;
+                    else if (IPCFIFO7.IsFull()) v |= 0x0002;
+                    if (IPCFIFO9.IsEmpty())     v |= 0x0100;
+                    else if (IPCFIFO9.IsFull()) v |= 0x0200;
+                    val = v;
+                    return true;
+                }
+            case 0x04000208: val = IME[1]; return true;
+            case 0x04000210: val = IE[1] & 0xFFFF; return true;
+            case 0x04000212: val = IE[1] >> 16; return true;
+            }
+        }
+        else if (sizeof(T) == 4)
+        {
+            switch (addr)
+            {
+            case 0x04000180: SliceIPC(1); val = IPCSync7; return true;
+            case 0x04000208: val = IME[1]; return true;
+            case 0x04000210: val = IE[1]; return true;
+            case 0x04000214: val = IF[1]; return true;
+            case 0x04100000: SliceIPC(1);
