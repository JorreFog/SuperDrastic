+                    else if (IPCFIFO7.IsFull()) v |= 0x0200;
+                    val = v;
+                    return true;
+                }
+            case 0x04000208: val = IME[0]; return true;
+            case 0x04000210: val = IE[0] & 0xFFFF; return true;
+            case 0x04000212: val = IE[0] >> 16; return true;
+            case 0x04000214: val = IF[0] & 0xFFFF; return true;
+            case 0x04000216: val = IF[0] >> 16; return true;
+            case 0x04000280: val = DivCnt; return true;
+            case 0x040002A0: val = DivQuotient[0] & 0xFFFF; return true;
+            case 0x040002A2: val = DivQuotient[0] >> 16; return true;
+            case 0x040002A4: val = DivQuotient[1] & 0xFFFF; return true;
+            case 0x040002A6: val = DivQuotient[1] >> 16; return true;
+            case 0x040002A8: val = DivRemainder[0] & 0xFFFF; return true;
+            case 0x040002AA: val = DivRemainder[0] >> 16; return true;
+            case 0x040002AC: val = DivRemainder[1] & 0xFFFF; return true;
+            case 0x040002AE: val = DivRemainder[1] >> 16; return true;
+            case 0x040002B0: val = SqrtCnt; return true;
+            case 0x040002B4: val = SqrtRes & 0xFFFF; return true;
+            case 0x040002B6: val = SqrtRes >> 16; return true;
+            }
+        }
+        else if (sizeof(T) == 4)
+        {
+            switch (addr)
+            {
+            case 0x04000180: SliceIPC(0); val = IPCSync9; return true;
+            case 0x04000208: val = IME[0]; return true;
+            case 0x04000210: val = IE[0]; return true;
+            case 0x04000214: val = IF[0]; return true;
+            case 0x04000280: val = DivCnt; return true;
+            case 0x04000290: val = DivNumerator[0]; return true;
+            case 0x04000294: val = DivNumerator[1]; return true;
+            case 0x04000298: val = DivDenominator[0]; return true;
+            case 0x0400029C: val = DivDenominator[1]; return true;
+            case 0x040002A0: val = DivQuotient[0]; return true;
+            case 0x040002A4: val = DivQuotient[1]; return true;
+            case 0x040002A8: val = DivRemainder[0]; return true;
+            case 0x040002AC: val = DivRemainder[1]; return true;
+            case 0x040002B0: val = SqrtCnt; return true;
+            case 0x040002B4: val = SqrtRes; return true;
