+// MELONDS_IOFAST's GX FIFO and command port route (IOFastWrite9's)
+[[gnu::noinline]] static void GXWrite9Route(melonDS::NDS& nds, u32 addr, u32 val)
+{
+    GPU3D& gpu3d = nds.GPU.GPU3D;
+    if (addr < 0x04000440)
+    {
+        if (gpu3d.GeometryEnabled)
+            gpu3d.WriteToGXFIFO(val);
+    }
+    else
+        gpu3d.Write32(addr, val);
+}
+
+template <typename T>
+[[gnu::noinline]] static void IOWrite9Route(melonDS::NDS& nds, u32 addr, u32 val)
+{
+    // ARM9Write*'s case 0x04000000 without its dispatch, the plain registers first
+    if (sizeof(T) >= 2 && nds.ARM9IOWriteDirect<T>(addr, (T)val))
+        return;
+    if (sizeof(T) == 4)
+        nds.NDS::ARM9IOWrite32(addr, val);
+    else if (sizeof(T) == 2)
+        nds.NDS::ARM9IOWrite16(addr, val);
+    else
+        nds.NDS::ARM9IOWrite8(addr, val);
+}
+
+// the common stores, inline, after side-effect-free checks; false: nothing done (a is aligned, not in the TCMs)
+template <typename T>
+static inline bool QuickWrite9(melonDS::NDS& nds, u32 a, u32 val, u32 flags)
+{
+    switch (a >> 24)
+    {
+    case 0x06:
+        // (CheckAndInvalidate<0, memregion_VRAM> has nothing to do: GPU::VRAMDirect has entries only while VRAM
+        // holds no compiled code)
+        if (sizeof(T) >= 2 && (flags & slow_MemVRAM))
+            return nds.GPU.WriteVRAMQuick<T>(a, val);
+        return false;
+    case 0x02:
+        // (CheckAndInvalidate<0, memregion_MainRAM> likewise)
+        if (flags & slow_MainRAM)
+        {
+            const u32 off = a & nds.MainRAMMask;
+            const AddressRange* code = &nds.JIT.CodeIndexMainRAM[off / 512];
+            __asm__("" : "+r"(code));
+            if (!((code->Code >> ((a & 0x1FF) / 16)) & 1))
+            {
+                *(T*)&nds.MainRAM[off] = val;
+                return true;
+            }
+        }
+        return false;
+    case 0x05:
+        if (sizeof(T) >= 2 && (flags & slow_MemVRAM))
+        {
+            if (nds.PowerControl9 & ((a & 0x400) ? (1<<9) : (1<<1)))
+            {
+                melonDS::GPU* gpu = &nds.GPU;
+                __asm__("" : "+r"(gpu));    // (one base for the GPU's members)
+                gpu->WritePalette<T>(a, val);
+            }
+            return true;
+        }
+        return false;
+    case 0x07:
+        if (sizeof(T) >= 2 && (flags & slow_MemVRAM))
+        {
+            if (nds.PowerControl9 & ((a & 0x400) ? (1<<9) : (1<<1)))
+            {
+                melonDS::GPU* gpu = &nds.GPU;
+                __asm__("" : "+r"(gpu));
