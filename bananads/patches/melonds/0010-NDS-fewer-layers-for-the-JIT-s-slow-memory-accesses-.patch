+// The JIT's slow loads and stores start here (MELONDS_MEMFAST, NDS_IOFast.h): the common cases inline, with no
+// call and no stack frame, after side-effect-free checks; anything else, or any check failing, goes to the full
+// path above, which does the whole thing (the checks again, the IO statistics, the TCMs, the routes, the chain).
+// The common cases: VRAM with the page's table entry current and plain (GPU::WriteVRAMQuick) and no compiled code
+// in the 16 bytes, palette and OAM, main RAM with no compiled code in the 16 bytes, the plain IO registers
+// (NDS::ARM9IOReadDirect/WriteDirect).
+template <typename T, int ConsoleType>
+T SlowRead9(u32 addr, ARMv5* cpu)
+{
+    if (ConsoleType == 0)
+    {
+        const u32 flags = SlowPathFlags;
+        const u32 a = addr & ~(u32)(sizeof(T) - 1);
+        if (!(flags & slow_FullPath) && a >= cpu->ITCMSize && (a & cpu->DTCMMask) != cpu->DTCMBase)
+        {
+            melonDS::NDS& nds = cpu->NDS;
+            T val;
+            bool done = false;
+            switch (a >> 24)
+            {
+            case 0x02:
+                if (flags & slow_MainRAM)
+                {
+                    val = *(T*)&nds.MainRAM[a & nds.MainRAMMask];
+                    done = true;
+                }
+                break;
+            case 0x04:
+                // (MELONDS_IOFAST's register reads, all below IPCSYNC; NDS::ARM9IOReadDirect's are from it on)
+                if (a < 0x04000180)
+                {
+                    if (!(flags & slow_IORead))
+                        break;
+                    if (sizeof(T) == 2)
+                    {
+                        switch (a)
+                        {
+                        case 0x04000004: val = nds.GPU.DispStat[0]; done = true; break;
+                        case 0x04000006: val = nds.GPU.VCount; done = true; break;
+                        case 0x04000130: nds.LagFrameFlag = false; val = nds.KeyInput & 0xFFFF; done = true; break;
+                        }
+                    }
+                    else if (sizeof(T) == 4 && a == 0x04000004)
+                    {
+                        val = nds.GPU.DispStat[0] | (nds.GPU.VCount << 16);
+                        done = true;
+                    }
+                }
+                else if (sizeof(T) >= 2 && (flags & slow_MemIO))
+                    done = nds.ARM9IOReadDirect<T>(a, val);
+                break;
+            case 0x05:
+                if (sizeof(T) >= 2 && (flags & slow_MemVRAM))
+                {
+                    val = (nds.PowerControl9 & ((a & 0x400) ? (1<<9) : (1<<1))) ? nds.GPU.ReadPalette<T>(a) : 0;
+                    done = true;
+                }
+                break;
+            case 0x06:
+                if (sizeof(T) >= 2 && (flags & slow_MemVRAM))
+                    done = nds.GPU.ReadVRAMQuick<T>(a, val);
+                break;
+            case 0x07:
+                if (sizeof(T) >= 2 && (flags & slow_MemVRAM))
+                {
+                    val = (nds.PowerControl9 & ((a & 0x400) ? (1<<9) : (1<<1))) ? nds.GPU.ReadOAM<T>(a & 0x7FF) : 0;
+                    done = true;
+                }
+                break;
+            }
+            if (done)
+                return sizeof(T) == 4 ? ROR(val, (addr & 0x3) << 3) : val;
+        }
+    }
+    return SlowRead9Full<T, ConsoleType>(addr, cpu);
+}
