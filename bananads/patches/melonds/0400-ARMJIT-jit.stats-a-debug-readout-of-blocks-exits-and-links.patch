diff -ruN '--exclude=.git' a/src/ARMJIT_Stats.cpp /home/joar/bdnight/obj/jit-integ/melonds/src/ARMJIT_Stats.cpp
--- a/src/ARMJIT_Stats.cpp
+++ b/src/ARMJIT_Stats.cpp
@@ -0,0 +1,57 @@
+// JIT statistics (BananaDS patch 0400): see ARMJIT_Stats.h
+#include <stdlib.h>
+#include <string.h>
+#include "ARMJIT_Stats.h"
+#include "Platform.h"
+
+namespace melonDS
+{
+using Platform::Log;
+using Platform::LogLevel;
+
+static int ReadStatsEnv()
+{
+    const char* e = getenv("MELONDS_JIT_STATS");
+    const long v = e ? strtol(e, nullptr, 0) : 0;
+    return v > 0 ? (int)v : 0;
+}
+
+int JitStatsEvery = 0;
+
+void JitStatsInit()
+{
+    JitStatsEvery = ReadStatsEnv();
+    if (JitStatsEvery)
+        Log(LogLevel::Info, "[jit] stats on: a line every %d frames\n", JitStatsEvery);
+}
+u64 JitStat[JS_Count] = {};
+static int JitStatsFrames = 0;
+
+void JitStatsFrame(NDS&)
+{
+    if (++JitStatsFrames < JitStatsEvery)
+        return;
+    const double f = JitStatsFrames;
+    const u64* s = JitStat;
+    auto pf = [&](int id) { return (double)s[id] / f; };
+    // ExitCheck/DynExit entries that didn't go back to the loop went on into a block (ExitCheck: through its
+    // slot, linked unless it was a link request)
+    const double ecOn9 = pf(JS_ExitCheck9) - pf(JS_ExitCheckLoop9), ecOn7 = pf(JS_ExitCheck7) - pf(JS_ExitCheckLoop7);
+    Log(LogLevel::Info, "[jit] stats %d frames, per frame: compiled 9:%.1f (thumb %.0f%%, %.1f instrs/block) 7:%.1f"
+        " (thumb %.0f%%) restored 9:%.1f 7:%.1f removed 9:%.1f 7:%.1f inval-addr %.1f resets %llu |"
+        " loop dispatch 9:%.0f 7:%.0f | ExitCheck 9:%.0f (to loop %.0f, on %.0f) 7:%.0f (to loop %.0f, on %.0f)"
+        " DynExit 9:%.0f (to loop %.0f) 7:%.0f (to loop %.0f) | self loops 9:%.0f 7:%.0f | slicechain %.0f ok %.0f |"
+        " link req %.1f linked %.1f\n",
+        JitStatsFrames, pf(JS_Compiled9), s[JS_Compiled9] ? 100.0 * s[JS_Thumb9] / s[JS_Compiled9] : 0.0,
+        s[JS_Compiled9] ? (double)s[JS_Instrs9] / s[JS_Compiled9] : 0.0, pf(JS_Compiled7),
+        s[JS_Compiled7] ? 100.0 * s[JS_Thumb7] / s[JS_Compiled7] : 0.0, pf(JS_Restored9), pf(JS_Restored7),
+        pf(JS_Removed9), pf(JS_Removed7), pf(JS_InvalAddr), (unsigned long long)s[JS_Resets],
+        pf(JS_Dispatch9), pf(JS_Dispatch7),
+        pf(JS_ExitCheck9), pf(JS_ExitCheckLoop9), ecOn9, pf(JS_ExitCheck7), pf(JS_ExitCheckLoop7), ecOn7,
+        pf(JS_DynExit9), pf(JS_DynExitLoop9), pf(JS_DynExit7), pf(JS_DynExitLoop7),
+        pf(JS_SelfLoop9), pf(JS_SelfLoop7), pf(JS_Chain9), pf(JS_ChainOk9), pf(JS_LinkReq), pf(JS_Linked));
+    memset(JitStat, 0, sizeof(JitStat));
+    JitStatsFrames = 0;
+}
+
+}
diff -ruN '--exclude=.git' a/src/ARMJIT_Stats.h /home/joar/bdnight/obj/jit-integ/melonds/src/ARMJIT_Stats.h
--- a/src/ARMJIT_Stats.h
+++ b/src/ARMJIT_Stats.h
@@ -0,0 +1,35 @@
+// JIT statistics (BananaDS patch 0400, `jit.stats`): counters for a debug readout, off by default.
+// MELONDS_JIT_STATS=N (N > 0): one "[jit] stats" log line every N frames (counts over those frames). Off: no counter is
+// touched anywhere and the exit stubs are emitted byte for byte as without this patch (the counters in the stubs
+// are only generated when it is on). The emulation doesn't see it either way (counters are host memory only).
+#ifndef ARMJIT_STATS_H
+#define ARMJIT_STATS_H
+
+#include "types.h"
+
+namespace melonDS
+{
+class NDS;
+
+enum JitStatId
+{
+    JS_Compiled9, JS_Compiled7, JS_Thumb9, JS_Thumb7, JS_Instrs9, JS_Instrs7, JS_Restored9, JS_Restored7,
+    JS_Removed9, JS_Removed7, JS_InvalAddr, JS_Resets,
+    JS_Dispatch9, JS_Dispatch7, JS_LinkReq, JS_Linked,
+    JS_ExitCheck9, JS_ExitCheck7, JS_ExitCheckLoop9, JS_ExitCheckLoop7,
+    JS_DynExit9, JS_DynExit7, JS_DynExitLoop9, JS_DynExitLoop7,
+    JS_SelfLoop9, JS_SelfLoop7, JS_Chain9, JS_ChainOk9,
+    JS_Count
+};
+
+extern int JitStatsEvery;          // frames per line, 0 = off (from MELONDS_JIT_STATS at the first use)
+extern u64 JitStat[JS_Count];
+
+inline bool JitStatsOn() { return JitStatsEvery > 0; }
+inline void JitStatInc(int id, u64 n = 1) { if (__builtin_expect(JitStatsEvery > 0, 0)) JitStat[id] += n; }
+void JitStatsFrame(NDS& nds);       // after each frame, when on
+void JitStatsInit();                // reads MELONDS_JIT_STATS (as the JIT compiler is created)
+
+}
+
+#endif
