+// J3 REGIONSTUB (patch 0342): ExecuteJITInline's region step below for DynExit (ARMJIT_Compiler.cpp), whose target
+// is outside the CPU's lookup region: 1 when the region now is the target's (then the stub looks the block up as the
+// loop would), 0 when both failed (then the stub returns to the loop, which tries the same again)
+u32 JitStubRegion(NDS* nds, u32 num, u32 instrAddr)
+{
+    NDS& n = *nds;
+    if (num == 0)
+        return (n.RegionPair && (n.RegionTrio ? SwapCodeRegion3<0>(n, n.ARM9, instrAddr) : SwapCodeRegion<0>(n, n.ARM9, instrAddr)))
+            || SetupExecutableRegionFor<0>(n, n.ARM9, instrAddr);
+    return (n.RegionPair && (n.RegionTrio ? SwapCodeRegion3<1>(n, n.ARM7, instrAddr) : SwapCodeRegion<1>(n, n.ARM7, instrAddr)))
+        || SetupExecutableRegionFor<1>(n, n.ARM7, instrAddr);
+}
