+
+bool Compiler::LazySafe(const FetchedInstr& in)
+{
+    // pending flags may stay pending over this instruction: compiled, reads no flags (or is an immediate branch,
+    // which checks them on the host's flags) and only touches NZCV/RCPSR in ways the emitter's hook sees
+    const u16 k = in.Info.Kind;
+    if (!CanCompile(Thumb, k))
+        return false;
+    if (Thumb)
+    {
+        if (k == ARMInstrInfo::tk_BCOND || k == ARMInstrInfo::tk_B)
+            return true;
+        if (LoopMode && (k == ARMInstrInfo::tk_PUSH || k == ARMInstrInfo::tk_POP || k == ARMInstrInfo::tk_LDMIA
+            || k == ARMInstrInfo::tk_STMIA))
+            return true;   // (in a LoopMode block only one register, not PC: a single access, LoopBlock)
+        return k < ARMInstrInfo::tk_PUSH && !(in.Info.ReadFlags & 0xF);
+    }
+    if ((k == ARMInstrInfo::ak_B || k == ARMInstrInfo::ak_BL) && in.Cond() != 0xF)
+        return true;
+    if (in.Cond() < 0xE || (in.Info.ReadFlags & 0xF))
+        return false;
+    return k < ARMInstrInfo::ak_SMLAxy || k == ARMInstrInfo::ak_CLZ
+        || (k >= ARMInstrInfo::ak_STR_REG_LSL && k <= ARMInstrInfo::ak_LDRSH_POST_IMM && !(k >= ARMInstrInfo::ak_LDRD_REG && k <= ARMInstrInfo::ak_STRD_POST_IMM));
+}
