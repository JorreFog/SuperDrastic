+void Compiler::Comp_FoldTakenExit(bool notTakenCycles)
+{
+    // A conditional immediate branch ending the block (FoldCondExit), its taken way: what the block's end does
+    // for it, here. The block's constant cycles are known: the not taken way's (Comp_AddCycles_C(true), when
+    // notTakenCycles) are the last to come, and both ways add all of them.
+    const s32 c = Num ? NDS.ARM7MemTimings[CurInstr.CodeCycles][Thumb ? 1 : 3]
+        : ((R15 & 0x2) ? 0 : CurInstr.CodeCycles);
+    const u32 total = ConstantCycles + (notTakenCycles ? c : 0) + FoldJumpCycles;
+    const bool self = OptSelfLoop && LinkBlocks && JumpR15Deferred && !R15Stored && LastJumpR15 == BlockEntryR15
+        && LastJumpThumb == Thumb;
+    if (!(LoopMode && self))
+    {
+        // (the stores the block's end makes: its RegCache.Flush, or in LoopMode PrepareExit)
+        BitSet16 dirty(RegCache.DirtyRegs);
+        for (int reg : dirty)
+            SaveReg(reg, RegCache.Mapping[reg]);
+    }
+    if (total)
+        ADD(RCycles, RCycles, total);
+    Comp_Exit(true, LastJumpR15, LastJumpThumb, JumpR15Deferred);
+}
