+bool Compiler::Comp_KnownCodeStore(u64 value)
+{
+    // true: the block already stored this value on every path to here, nothing to store. Else the caller stores
+    // it, and when this instruction always runs, it is known from here on.
+    if (!OptCodeStores)
+        return false;
+    if (KnownCodeValid && KnownCodeValue == value)
