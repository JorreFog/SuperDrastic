+void Compiler::Comp_EntryPrologue()
+{
+    // The entry the runtime dispatches to: x26 = the CPU's fast memory base, always four instructions
+    // (EntrySkip). Exits that go straight on into a block (link slots, DynExit) enter past it: x26 is callee-saved
+    // and only blocks of the same CPU set it, so it still holds the base there.
+    const u64 base = (u64)(uintptr_t)(Num == 0 ? NDS.JIT.Memory.FastMem9Start : NDS.JIT.Memory.FastMem7Start);
+    Write32(0xD2800000 | ((u32)(base & 0xFFFF) << 5) | 26);                          // movz x26, #.., lsl #0
+    for (int hw = 1; hw < 4; hw++)
+        Write32(0xF2800000 | (hw << 21) | ((u32)((base >> (16 * hw)) & 0xFFFF) << 5) | 26);   // movk x26, #.., lsl #16*hw
+}
+
 void Compiler::Link(u8* slotRX, ARM* cpu, u8* entry)
 {
+    entry += EntrySkip[cpu->Num];   // (past the entry prologue)
