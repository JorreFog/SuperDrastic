+// FastMix: the channels' part of Mix. A channel's output (Run's return value, and its two panned terms) only
+// changes when it takes a new sample (its timer overflows), on a write to its registers (SetCnt, SetLoopPos,
+// SetLength clear FastValid) or when it stops. So while no sample is due, Run would only add the cycles to Timer
+// and return the same value again. Each channel keeps the Mix at which its timer overflows next (ChanDue); a Mix
+// runs only the channels due (all of them after any SPU register write: FastDirty), and a Mix with none due
+// returns the last sums. The timers of the channels skipped are owed those Mixes' cycles (FastLazy, FastSync),
+// added before they run again or are saved. Not with interpolation (its value depends on Timer), nor when Run
+// returned before running the timer (FastValid stays false: such a channel runs every Mix). Channels that are off
+// add 0, as Run's first check does. The sums are integer adds (NEON), so their order doesn't matter; channels 1
+// and 3 are left out of the mixers as Mix does (SOUNDCNT bits 12 and 13).
+// FastMix: Run<type> for a channel known to be on, keyed already (KeyOn false), long enough and not interpolated
+// (FastValid), whose timer overflows in this Mix (timer: Timer plus this Mix's cycles): its sample loop and output,
+// without Run's checks, with the NextSample and FIFO reads inline (flatten: one call per sample, nothing below it).
+template<u32 type>
+[[gnu::noinline, gnu::flatten]] static s32 RunValid(SPUChannel& chan, u32 timer)
+{
+    chan.Timer = timer;
+    while (chan.Timer >> 16)
+    {
+        chan.Timer = chan.TimerReload + (chan.Timer - 0x10000);
+
+        switch (type)
+        {
+        case 0: chan.NextSample_PCM8(); break;
+        case 1: chan.NextSample_PCM16(); break;
+        case 2: chan.NextSample_ADPCM(); break;
+        case 3: chan.NextSample_PSG(); break;
+        case 4: chan.NextSample_Noise(); break;
+        }
+
+        if (!(chan.Cnt & (1<<31))) break;
+    }
+
+    s32 val = (s32)chan.CurSample;
+    val <<= chan.VolumeShift;
+    val *= chan.Volume;
+    return val;
+}
+
+bool SPU::MixChannelsFast(u32 spucycles, s32& left, s32& right, s32& ch1, s32& ch3)
+{
+    const u32 mix = ++FastCount;
+    if (spucycles != FastCycles)
+    {
+        SyncFastTimers(mix - 1);
+        FastCycles = spucycles;
+        FastDirty = true;
+    }
+
+    // No register written and no channel's timer overflowing since the last time they ran: every channel's output
+    // is the same, so the sums are too. The timers are owed this Mix's cycles (SyncFastTimers).
+    if (!FastDirty && (s32)(mix - FastNextDue) < 0)
+    {
+        left = FastLeft; right = FastRight; ch1 = FastCh1; ch3 = FastCh3;
+        return true;
+    }
+
+    // Run the channels that are due (all of them after a register write); the others keep their output. Running a
+    // channel that isn't due is harmless (it adds its cycles and keeps its output), skipping one that is due isn't.
+    u32 duemask = 0xFFFF;
+    if (!FastDirty)
+    {
+#if defined(__aarch64__)
+        // NEON: lanes whose (due - mix) <= 0, as a 16-bit mask
+        static const u32 bitsv[16] = {1,2,4,8, 16,32,64,128, 256,512,1024,2048, 4096,8192,16384,32768};
+        const uint32_t mixv = mix;
+        const uint32x4_t m = vdupq_n_u32(mixv);
+        uint32x4_t acc = vdupq_n_u32(0);
+        for (int q = 0; q < 4; q++)
+        {
+            int32x4_t d = vreinterpretq_s32_u32(vsubq_u32(vld1q_u32(&ChanDue[q*4]), m));
+            acc = vorrq_u32(acc, vandq_u32(vcleq_s32(d, vdupq_n_s32(0)), vld1q_u32(&bitsv[q*4])));
+        }
+        duemask = vaddvq_u32(acc);
+#else
+        duemask = 0;
+        for (int i = 0; i < 16; i++)
+            if ((s32)(ChanDue[i] - mix) <= 0) duemask |= 1u << i;
+#endif
+    }
+    FastDirty = false;
+    const u32 cycshift = (spucycles & (spucycles - 1)) ? 0 : __builtin_ctz(spucycles);
+    for (; duemask; duemask &= duemask - 1)
+    {
+        const int i = __builtin_ctz(duemask);
+        SPUChannel& chan = Channels[i];
+        if (chan.FastLazy)
+        {
+            // the Mixes skipped since it last ran, before this one
+            chan.Timer += (mix - 1 - chan.FastSync) * spucycles;
+            chan.FastLazy = false;
+        }
+        if (!(chan.Cnt & (1u<<31)))
+        {
+            ChanL[i] = 0; ChanR[i] = 0; ChanOut[i] = 0;
+            ChanDue[i] = mix + 0x7FFFFFFF; // until a write turns it on (and then a while)
+            continue;
+        }
+
+        u32 timer = chan.Timer + spucycles;
+        if (chan.FastValid && !(timer >> 16))
+        {
+            chan.Timer = timer;
+        }
+        else
+        {
+            s32 val;
+            if (chan.FastValid)
+            {
+                // (it stays FastValid unless the sample ended it: FastValid's other conditions can't change here)
+                switch ((chan.Cnt >> 29) & 0x3)
+                {
+                case 0: val = RunValid<0>(chan, timer); break;
+                case 1: val = RunValid<1>(chan, timer); break;
+                case 2: val = RunValid<2>(chan, timer); break;
+                default: val = (i >= 14) ? RunValid<4>(chan, timer) : RunValid<3>(chan, timer); break;
+                }
+                chan.FastValid = chan.Cnt >> 31;
+            }
+            else
+            {
+                val = chan.DoRun(spucycles);
+                const u32 cnt = chan.Cnt;
+                const u32 fmt = (cnt >> 29) & 0x3;
+                chan.FastValid = (cnt & (1u<<31)) && chan.InterpType == AudioInterpolation::None &&
+                                 (fmt == 3 ? chan.Num >= 8 : (chan.Length + chan.LoopPos) >= 16);
+            }
+            s32 l = ((s64)val * (128-chan.Pan)) >> 10;
+            s32 r = ((s64)val * chan.Pan) >> 10;
+            ChanOut[i] = val; ChanL[i] = l; ChanR[i] = r;
+        }
+
+        if (chan.FastValid)
+        {
+            // its timer overflows in the Mix that takes it to 0x10000
+            chan.FastLazy = true;
+            chan.FastSync = mix;
+            u32 rem = 0x10000 - chan.Timer + spucycles - 1;
+            ChanDue[i] = mix + (cycshift ? (rem >> cycshift) : (rem / spucycles));
+        }
+        else
+            ChanDue[i] = mix + 1; // runs every Mix
+    }
+
