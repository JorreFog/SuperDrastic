+// FastDMA: ARM9Write16/32 on a DS for main RAM, palette, VRAM and OAM, without the call and the dispatch: the same
+// JIT check and store, the same power checks and GPU calls; VRAM through the page table (GPU::WriteVRAMDirect: one
+// bank at the page, no compiled code in VRAM), else ARM9Write's own path
+template<typename T>
+inline void DMA::FastWrite9(u32 addr, T val)
+{
+    addr &= ~(u32)(sizeof(T) - 1);
+    switch (addr >> 24)
+    {
+    case 0x02:
+        NDS.JIT.CheckAndInvalidate<0, ARMJIT_Memory::memregion_MainRAM>(addr);
+        *(T*)&NDS.MainRAM[addr & NDS.MainRAMMask] = val;
+        return;
+    case 0x05:
+        if (!(NDS.PowerControl9 & ((addr & 0x400) ? (1<<9) : (1<<1)))) return;
+        NDS.GPU.WritePalette<T>(addr, val);
+        return;
+    case 0x06:
+        if (NDS.GPU.WriteVRAMDirect<T>(addr, val)) return;
+        break;
+    case 0x07:
+        if (!(NDS.PowerControl9 & ((addr & 0x400) ? (1<<9) : (1<<1)))) return;
+        NDS.GPU.WriteOAM<T>(addr, val);
+        return;
+    }
+    if (sizeof(T) == 4) NDS.ARM9Write32(addr, val);
+    else NDS.ARM9Write16(addr, val);
+}
