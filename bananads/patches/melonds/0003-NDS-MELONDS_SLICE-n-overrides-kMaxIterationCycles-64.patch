From 9ee7dc2c1ecf0f104f355ae2ec9a236319f4afe4 Mon Sep 17 00:00:00 2001
From: JorreFog <JorreFog@users.noreply.github.com>
Date: Sun, 11 Oct 2026 19:28:00 +0200
Subject: [PATCH 3/3] NDS: MELONDS_SLICE=n overrides kMaxIterationCycles (64),
 for measuring the scheduler's cost

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RUpenk3BsbrZDbkXGeg4Qh
---
 src/NDS.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/NDS.cpp b/src/NDS.cpp
index c6dc85fa..eac3a1d4 100644
--- a/src/NDS.cpp
+++ b/src/NDS.cpp
@@ -19,6 +19,7 @@
 #include <assert.h>
 #include <stdio.h>
 #include <string.h>
+#include <stdlib.h>
 #include <inttypes.h>
 #include "NDS.h"
 #include "ARM.h"
@@ -49,7 +50,14 @@ namespace melonDS
 {
 using namespace Platform;
 
-const s32 kMaxIterationCycles = 64;
+// the most system cycles one iteration of RunFrame's loop runs the CPUs for (melonDS: 64); MELONDS_SLICE=n for
+// tests
+static const s32 kMaxIterationCycles = []
+{
+    const char* e = getenv("MELONDS_SLICE");
+    const int v = e ? atoi(e) : 0;
+    return v > 0 ? (s32)v : (s32)64;
+}();
 const s32 kIterationCycleMargin = 8;
 
 // timing notes
