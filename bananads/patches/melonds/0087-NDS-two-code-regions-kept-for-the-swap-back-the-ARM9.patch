index 8a09fa3..1dc5f6c 100644
--- a/src/NDS.h
+++ b/src/NDS.h
@@ -321,9 +321,27 @@ public: // TODO: Encapsulate the rest of these members
 #ifdef JIT_ENABLED
         ARM9.FastBlockLookupAltSize = 0;
         ARM7.FastBlockLookupAltSize = 0;
