 #endif
     }
     bool RegionPair = false;
+    // RegionTrio (exact, BananaDS patch 0087; with RegionPair): two regions the PC left are kept, not one, and the
+    // ARM9's BIOS and the ARM7's shared WRAM can be kept too (an IRQ takes the ARM9 from main RAM through its BIOS
+    // to an ITCM handler and back; the ARM7's sound driver runs in shared WRAM and goes through its BIOS). On by
+    // default; off is RegionPair's own way
+    void SetRegionTrio(bool on) noexcept
