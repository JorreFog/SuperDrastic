+        RegionTrio = on;
+#ifdef JIT_ENABLED
+        ARM9.FastBlockLookupAltSize = 0;
+        ARM7.FastBlockLookupAltSize = 0;
+        ARM9.FastBlockLookupAlt2Size = 0;
+        ARM7.FastBlockLookupAlt2Size = 0;
+#endif
+    }
+    bool RegionTrio = true;
+    bool SwapCodeRegionTrio(u32 num, u32 instrAddr) noexcept;
     u64 HaltSkipped = 0; // (how many times it did)
     u32 SliceChainStep() noexcept;
     // FastDMA (BananaDS, DMA.h): main RAM -> GX FIFO / main RAM transfers without the bus dispatch; exact
