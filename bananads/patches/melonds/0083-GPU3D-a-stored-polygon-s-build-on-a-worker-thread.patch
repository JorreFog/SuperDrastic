+    u64 localwrecip[10];
+    Vertex* clippedvertices = localvertices;
+    u64* wrecip = localwrecip;
+    if constexpr (Threaded)
+    {
+        {
+            job = GeomSlot();
+            clippedvertices = job->V;
+            wrecip = job->WRecip;
+        }
+    }
     Vertex* reusedvertices[2];
     int clipstart = 0;
     int lastpolyverts = 0;
