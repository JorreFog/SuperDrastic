+    if constexpr (Threaded)
+    {
+        {
+            // render.geom_thread: the rest is the worker's (GeomBuild); the polygon's place and the vertex count as
+            // the build leaves them, and the shadow of the polygon for the next one of a strip, are kept here
+            Vertex* const base = &CurVertexRAM[NumVertices];
+            job->Poly = &CurPolygonRAM[NumPolygons++];
+            job->Prev = LastStripPolygon;
+            job->VtxBase = base;
+            job->NVerts = nverts; job->ClipStart = clipstart; job->LastPolyVerts = lastpolyverts;
+            job->FacingView = facingview; job->PolyType = polytype;
+            job->Attr = CurPolygonAttr; job->TexParam = TexParam; job->TexPalette = TexPalette;
+            job->FlushAttributes = FlushAttributes; job->PolygonMode = PolygonMode;
+            job->NumConsecutivePolygons = NumConsecutivePolygons;
+            const bool copied2 = LastStripPolygon && clipstart > 0 && nverts != lastpolyverts;
+            const u32 nb = copied2 ? 2 : 0;
+            NumVertices += nb + (nverts - clipstart);
+            if (PolygonMode >= 2)
+            {
+                if (clipstart > 0)
+                {
+                    const Vertex s0 = *reusedvertices[0], s1 = *reusedvertices[1];
+                    Vertex* const p0 = copied2 ? &base[0] : job->Reuse[0];
+                    Vertex* const p1 = copied2 ? &base[1] : job->Reuse[1];
+                    GeomShadow.V[0] = s0; GeomShadow.V[1] = s1;
+                    GeomShadow.P[0] = p0; GeomShadow.P[1] = p1;
+                }
+                for (int i = clipstart; i < nverts && i < 4; i++)
+                {
+                    GeomShadow.V[i] = clippedvertices[i];
+                    GeomShadow.P[i] = &base[nb + (i - clipstart)];
+                }
+                GeomShadow.NumVertices = nverts;
+                GeomShadowValid = true;
+                LastStripPolygon = job->Poly;
+            }
+            else
+                LastStripPolygon = NULL;
