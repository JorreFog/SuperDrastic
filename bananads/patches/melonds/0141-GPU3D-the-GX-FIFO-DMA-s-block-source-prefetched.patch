From 9ad77ab2309ed429bd8b0bddff42036374a3320d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 00:18:36 +0100
Subject: [PATCH] GPU3D: the GX FIFO DMA's block source prefetched
 (render.gx_prefetch)

---
 src/GPU3D.cpp | 16 ++++++++++++++++
 src/GPU3D.h   |  3 +++
 2 files changed, 19 insertions(+)

diff --git a/src/GPU3D.cpp b/src/GPU3D.cpp
index fbad252..587b765 100644
--- a/src/GPU3D.cpp
+++ b/src/GPU3D.cpp
@@ -3450,6 +3450,13 @@ int GPU3D::GeomSabEnv() noexcept
     return e ? atoi(e) : 0;
 }
 
+bool GPU3D::GeomPrefetchEnv() noexcept
+{
+    // read as the GPU3D is created
+    const char* e = getenv("MELONDS_GXPREFETCH");
+    return !(e && e[0] == '0');
+}
+
 bool GPU3D::GeomRejectEnv() noexcept
 {
     // read as the GPU3D is created
@@ -4153,6 +4160,15 @@ __attribute__((noinline, no_stack_protector)) void GPU3D::WriteGXFIFOWords(const
 
 __attribute__((no_stack_protector)) u32 GPU3D::WriteGXFIFOBlock(const u8* ram, u32 mask, u32 src, u32 n) noexcept
 {
+    if (GeomPrefetch)
+    {
+        // render.gx_prefetch: the block's cache lines and the next 192 bytes (the DMA's next blocks: a model's
+        // display list, read once a frame, is mostly not in the caches), asked for at once instead of one miss at
+        // a time as the loop below reaches them (the A55 waits on a load's miss). A prefetch changes nothing else.
+        const u32 bytes = (n << 2) + 192;
+        for (u32 o = 0; o < bytes; o += 64)
+            __builtin_prefetch(&ram[(src + o) & mask]);
+    }
     if (GXDMAFast && GeometryEnabled && !(NDS.CPUStop & CPUStop_GXStall)) [[likely]]
         return WriteGXFIFOWordsFast<true>([ram, mask, src](u32 i) __attribute__((always_inline))
             { return *(const u32*)&ram[(src + (i << 2)) & mask]; }, n);
diff --git a/src/GPU3D.h b/src/GPU3D.h
index d881183..376d172 100644
--- a/src/GPU3D.h
+++ b/src/GPU3D.h
@@ -457,6 +457,9 @@ public:
     static bool GeomRejectEnv() noexcept;
     bool GeomReject = GeomRejectEnv();
     bool PolygonClippedAway() const noexcept;
+    // render.gx_prefetch (MELONDS_GXPREFETCH): the GX FIFO DMA's block's source prefetched
+    static bool GeomPrefetchEnv() noexcept;
+    bool GeomPrefetch = GeomPrefetchEnv();
     // BananaDS (render.geom_thread, MELONDS_GEOMTHREAD=0 turns it off; exact): with GeomFast a stored
     // polygon's build (its fields, bounds, W and Z, and its new vertices' copy into vertex RAM) runs on a worker
     // thread; every decision that sets timing or the counts (culling, clipping, zero-dot, RAM full, the strip's
-- 
