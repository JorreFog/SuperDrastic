From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BananaDS <bananads@localhost>
Date: Sun, 18 Oct 2026 19:53:12 +0000
Subject: [PATCH 40/42] ARMJIT_A64: ARM_Dispatch sets x26, blocks have no entry
 prologue (MELONDS_JIT_NOENTRYX26)


The first session's 0024 (perf/jit, agent jit), renumbered. 0007's FASTENTRY put the fast memory base into x26
with a 3-instruction prologue at every block's start, which the loop's ARM_Dispatch entered and linked exits
skipped. ARM_Dispatch now takes the base as a third argument (ARMJIT_Memory::FastMemStart(num)) and sets x26
itself, so blocks have no prologue: 12 bytes less per block (tests/bigcode: 4.0% of the blocks' bytes) and three
instructions less per dispatch. Everything else that enters a block (a linked slot, DynExit, a self loop, the
fault handler's context restore) comes from code of the same CPU, where x26 already holds it.
MELONDS_JIT_NOENTRYX26=1 (or jit.codegen=old) keeps the prologue; x26 is then set twice on a dispatch.
---
  src/ARM.cpp                        | 4 ++--
  src/ARMJIT.h                       | 5 +++--
  src/ARMJIT_A64/ARMJIT_Compiler.cpp | 8 ++++++--
  src/ARMJIT_A64/ARMJIT_Compiler.h   | 3 +++
  src/ARMJIT_A64/ARMJIT_Linkage.S    | 3 ++-
  src/ARMJIT_Memory.h                | 2 ++
  src/NDS.cpp                        | 2 +-
  7 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/src/ARM.cpp b/src/ARM.cpp
index 3937a994fc7e0ea0f6349d79b7ac869290a3c5b2..9c5b8e402b2d2dd88d50ea0195cbaa9d4f5cb6de 100644
--- a/src/ARM.cpp
+++ b/src/ARM.cpp
@@ -632,7 +632,7 @@ void ARMv5::Execute()
             JitBlockEntry block = NDS.JIT.LookUpBlock(0, FastBlockLookup,
                 instrAddr - FastBlockLookupStart, instrAddr);
             if (block)
-                ARM_Dispatch(this, block);
+                ARM_Dispatch(this, block, NDS.JIT.Memory.FastMemStart(0));
             else
                 NDS.JIT.CompileBlock(this);
 
@@ -772,7 +772,7 @@ void ARMv4::Execute()
             JitBlockEntry block = NDS.JIT.LookUpBlock(1, FastBlockLookup,
                 instrAddr - FastBlockLookupStart, instrAddr);
             if (block)
-                ARM_Dispatch(this, block);
+                ARM_Dispatch(this, block, NDS.JIT.Memory.FastMemStart(1));
             else
                 NDS.JIT.CompileBlock(this);
 
diff --git a/src/ARMJIT.h b/src/ARMJIT.h
index 4a9b85f09e4af29bd0d6234dadeff86575674d02..1fff35a2391d5f0ece0b9cd3f12fa917f92821f9 100644
--- a/src/ARMJIT.h
+++ b/src/ARMJIT.h
@@ -191,8 +191,9 @@ public:
 };
 }
 
-// Defined in assembly
-extern "C" void ARM_Dispatch(melonDS::ARM* cpu, melonDS::JitBlockEntry entry);
+// Defined in assembly. fastMem: the CPU's fast memory base (ARMJIT_Memory::FastMemStart); the AArch64 one puts it
+// in x26 for the block (patch 0040: blocks have no entry prologue setting it)
+extern "C" void ARM_Dispatch(melonDS::ARM* cpu, melonDS::JitBlockEntry entry, void* fastMem);
 #else
 namespace melonDS
 {
diff --git a/src/ARMJIT_A64/ARMJIT_Compiler.cpp b/src/ARMJIT_A64/ARMJIT_Compiler.cpp
index ff49adba962f4213396d7db2ec57baf273608ad0..5aeb0c8b05cafd874202842bcb209188f98ec062 100644
--- a/src/ARMJIT_A64/ARMJIT_Compiler.cpp
+++ b/src/ARMJIT_A64/ARMJIT_Compiler.cpp
@@ -285,6 +285,7 @@ Compiler::Compiler(melonDS::NDS& nds) : Arm64Gen::ARM64XEmitter(), NDS(nds)
             const char* sc = getenv("MELONDS_JIT_SLICECHAIN");
             OptSliceChain = OptExitStub && !(sc && *sc == '0');
         }
+        OptNoPrologue = OptFastEntry && !getenv("MELONDS_JIT_NOENTRYX26");
         OptKeepFlags = !old && !getenv("MELONDS_JIT_NOKEEPFLAGS");
         // LOOPREGS only with MELONDS_JIT_LOOPREGS=1: on an RG DS Plus, HeartGold (USA) goes to a black screen at its
         // first overworld frame with it (frame 1200 of tools/device/hgquick.sh's walk), and fine with it off alone.
@@ -310,7 +311,7 @@ Compiler::Compiler(melonDS::NDS& nds) : Arm64Gen::ARM64XEmitter(), NDS(nds)
             u32 n = 1;
             for (int hw = 1; hw < 4; hw++)
                 n += ((base >> (16 * hw)) & 0xFFFF) != 0;
-            EntrySkip[num] = OptFastEntry ? 4 * n : 0;
+            EntrySkip[num] = (OptFastEntry && !OptNoPrologue) ? 4 * n : 0;
         }
     }
 
@@ -1448,7 +1449,10 @@ JitBlockEntry Compiler::CompileBlock(ARM* cpu, bool thumb, FetchedInstr instrs[]
 
     KnownCodeValid = false;
     if (OptFastEntry)
-        Comp_EntryPrologue();
+    {
+        if (!OptNoPrologue)
+            Comp_EntryPrologue();
+    }
     else if (hasMemInstr)
         MOVP2R(RMemBase, Num == 0 ? NDS.JIT.Memory.FastMem9Start : NDS.JIT.Memory.FastMem7Start);
 
diff --git a/src/ARMJIT_A64/ARMJIT_Compiler.h b/src/ARMJIT_A64/ARMJIT_Compiler.h
index f2898201e66509863e091d6930818dc32f856c13..5014f9e6a8fdc233ce4249eb964a63f01b831eba 100644
--- a/src/ARMJIT_A64/ARMJIT_Compiler.h
+++ b/src/ARMJIT_A64/ARMJIT_Compiler.h
@@ -287,6 +287,9 @@ public:
     bool OptSliceChain = true;    // MELONDS_JIT_SLICECHAIN=0: the ARM9's exits whose slice has ended ask
                                   // NDS::SliceChain9 whether the slice loop would only keep time, and go on if so
     const void* SliceChainStub = nullptr;   // (a self loop's late way BLs it: x4/x30 kept round SliceChain9's call)
+    bool OptNoPrologue = true;    // NOENTRYX26 (patch 0040, the first session's 0024): no FASTENTRY prologue in the
+                                  // blocks: ARM_Dispatch sets x26, and everything else that enters a block comes from
+                                  // a block of the same CPU
     bool OptLoopRegs = false;     // LOOPREGS=1 (off by default): a block that loops back to its own start keeps the guest registers
                                   // it uses in host registers round the loop (LoopMode)
     bool LoopNoTs = false, LoopNoSigned = false, LoopNoLazy = false, LoopNoXfer = false;   // (LOOPREGS's parts)
diff --git a/src/ARMJIT_A64/ARMJIT_Linkage.S b/src/ARMJIT_A64/ARMJIT_Linkage.S
index 40a70f426fd7029963f5926dfa136330cfd785bc..5ad13112904f84aaa29d7f6994e2ef4274aa6437 100644
--- a/src/ARMJIT_A64/ARMJIT_Linkage.S
+++ b/src/ARMJIT_A64/ARMJIT_Linkage.S
@@ -39,6 +39,7 @@ ARM_Dispatch:
     stp x25, x26, [sp, #48]
     stp x27, x28, [sp, #64]
     stp x29, x30, [sp, #80]
+    mov x26, x2     // the CPU's fast memory base (patch 0040: no entry prologue in the blocks)
 
     // block linking: link the exit that just came back here (its slot in melonds_jit_link) to this block
 #ifdef __APPLE__
@@ -49,7 +50,7 @@ ARM_Dispatch:
     ldr x2, [x2, :lo12:melonds_jit_link]
 #endif
     cbz x2, 1f
-    stp x0, x1, [sp, #-16]!
+    stp x0, x1, [sp, #-16]!       // (x26 is callee-saved: it survives the call)
 #ifdef __APPLE__
     bl _melonds_jit_link_pending
 #else
diff --git a/src/ARMJIT_Memory.h b/src/ARMJIT_Memory.h
index a1116ce374e163ff25bb837d294e67467da65187..323a83015bb802d7873660ddb626bf71e224eb37 100644
--- a/src/ARMJIT_Memory.h
+++ b/src/ARMJIT_Memory.h
@@ -161,6 +161,8 @@ public:
 
     static u32 PageSize;
     static u32 PageShift;
+    // a CPU's fast memory base, for ARM_Dispatch's x26 (patch 0040)
+    void* FastMemStart(u32 num) const noexcept { return num ? FastMem7Start : FastMem9Start; }
 private:
     friend class Compiler;
     struct Mapping
diff --git a/src/NDS.cpp b/src/NDS.cpp
index 56f60c9890172794359b366fe5c519c6489c84d0..2cd31e907113816fd840ab91e272e0e7458fb6ea 100644
--- a/src/NDS.cpp
+++ b/src/NDS.cpp
@@ -1247,7 +1247,7 @@ template <u32 num, typename CPU>
         // LookUpBlock
         const u64 entry = cpu.FastBlockLookup[offset / 2];
         if (entry >> 32 == (instrAddr | num)) [[likely]]
-            ARM_Dispatch(&cpu, (JitBlockEntry)(rxBase + (u32)entry));
+            ARM_Dispatch(&cpu, (JitBlockEntry)(rxBase + (u32)entry), nds.JIT.Memory.FastMemStart(num));
         else
             nds.JIT.CompileBlock(&cpu);
 
