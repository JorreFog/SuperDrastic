From fd630edd2fab2a11ae781fe5fac33093adaf248a Mon Sep 17 00:00:00 2001
From: BananaDS <bananads@localhost>
Date: Mon, 19 Oct 2026 10:13:59 +0000
Subject: [PATCH] ARMJIT: the ARM7's slow accesses to its own WRAM straight to
 it (memfast_WRAM7)

The ARM7's JIT code takes the slow path for many loads and stores to its WRAM at 0x03800000 (stores into pages that
hold compiled code fault once and stay slow calls): in Mario Kart DS's race start ~1,040 stores, ~450 STMs (~2,000
words), ~170 loads and ~60 LDMs (~450 words) a frame, the sound driver's state next to its code. Each word went
SlowWrite7 -> NDS::ARM7Write32 (a virtual call through NDS::Current, a frame of three register pairs, the region
switch) -> the JIT's code check -> the store; ARM7Write32 alone was ~0.8% of the emulator's thread on the RG DS Plus.

On the DS (ConsoleType 0) and with MELONDS_MEMFAST's new bit 8 (memfast_WRAM7), SlowRead7, SlowWrite7 and
SlowBlockTransfer7 do what ARM7Read*/ARM7Write*'s case 0x03800000 does, without the dispatch: the same
CheckAndInvalidate<1, memregion_WRAM7> and the same store (or load) at addr & (ARM7WRAMSize - 1). A block whose first
and last words are both in 0x03800000-0x03FFFFFF goes word by word in the same order with one dispatch (the
mirrors wrap by the mask, as ARM7Read32/ARM7Write32's do); anything else takes the old path. The IO statistics
count the accesses as before (before the route). Under qemu, MK frames 1680-2100: ARM7Write32/16/8 and ARM7Read32
-181k instructions a frame, SlowRead7, SlowWrite7 and SlowBlockTransfer7 +19k: -162k.
---
 src/ARMJIT.cpp     | 41 +++++++++++++++++++++++++++++++++++++++--
 src/NDS_IOFast.cpp |  2 +-
 src/NDS_IOFast.h   |  4 ++++
 3 files changed, 44 insertions(+), 3 deletions(-)

diff --git a/src/ARMJIT.cpp b/src/ARMJIT.cpp
index 8b6a68f..3ee6da5 100644
--- a/src/ARMJIT.cpp
+++ b/src/ARMJIT.cpp
@@ -377,7 +377,12 @@ static inline T SlowRead7Impl(u32 addr)
     addr &= ~(sizeof(T) - 1);
 
     T val;
-    if (ConsoleType == 0 && (MemFastParts & memfast_IO) && (addr & 0xFF800000) == 0x04000000)
+    if (ConsoleType == 0 && (addr & 0xFF800000) == 0x03800000 && (SlowPathFlags & slow_MemWRAM7))
+    {
+        // memfast_WRAM7: ARM7Read*'s case 0x03800000 without its dispatch
+        val = *(T*)&NDS::Current->ARM7WRAM[addr & (ARM7WRAMSize - 1)];
+    }
+    else if (ConsoleType == 0 && (MemFastParts & memfast_IO) && (addr & 0xFF800000) == 0x04000000)
     {
         // ARM7Read*'s case 0x04000000 without its dispatch, the plain registers first
         melonDS::NDS& nds = *NDS::Current;
@@ -559,7 +564,14 @@ static inline void SlowWrite7Impl(u32 addr, u32 val)
 {
     addr &= ~(sizeof(T) - 1);
 
-    if (ConsoleType == 0 && (MemFastParts & memfast_IO) && (addr & 0xFF800000) == 0x04000000)
+    if (ConsoleType == 0 && (addr & 0xFF800000) == 0x03800000 && (SlowPathFlags & slow_MemWRAM7))
+    {
+        // memfast_WRAM7: ARM7Write*'s case 0x03800000 without its dispatch (the same check, then the store)
+        melonDS::NDS& nds = *NDS::Current;
+        nds.JIT.CheckAndInvalidate<1, ARMJIT_Memory::memregion_WRAM7>(addr);
+        *(T*)&nds.ARM7WRAM[addr & (ARM7WRAMSize - 1)] = val;
+    }
+    else if (ConsoleType == 0 && (MemFastParts & memfast_IO) && (addr & 0xFF800000) == 0x04000000)
     {
         // ARM7Write*'s case 0x04000000 without its dispatch
         melonDS::NDS& nds = *NDS::Current;
@@ -695,6 +707,31 @@ void SlowBlockTransfer7(u32 addr, u64* data, u32 num)
 {
     addr &= ~0x3;
     MELONDS_IOSTAT(Write ? iostat_Block7Write : iostat_Block7Read, addr, 4, num);
+    if (ConsoleType == 0 && num && (SlowPathFlags & slow_MemWRAM7) && (addr & 0xFF800000) == 0x03800000
+        && ((addr + (num - 1) * 4) & 0xFF800000) == 0x03800000)
+    {
+        // memfast_WRAM7: every word in the ARM7's WRAM (its mirrors wrap by the mask, as ARM7Read32/ARM7Write32's
+        // do): their case 0x03800000 word by word, in the same order, with one dispatch for the block
+        // (CheckAndInvalidate<1, memregion_WRAM7>(addr) with its index loaded once: LocaliseAddress's WRAM7 case is
+        // (addr & (ARM7WRAMSize - 1)) | (memregion_WRAM7 << 27))
+        melonDS::NDS& nds = *NDS::Current;
+        u8* const wram = nds.ARM7WRAM;
+        const AddressRange* const code = nds.JIT.CodeMemRegions[ARMJIT_Memory::memregion_WRAM7];
+        for (u32 i = 0; i < num; i++)
+        {
+            const u32 off = addr & (ARM7WRAMSize - 1);
+            if (Write)
+            {
+                if (code[off / 512].Code & (1 << ((off & 0x1FF) / 16)))
+                    nds.JIT.InvalidateByAddr(off | (ARMJIT_Memory::memregion_WRAM7 << 27));
+                *(u32*)&wram[off] = data[i];
+            }
+            else
+                data[i] = *(u32*)&wram[off];
+            addr += 4;
+        }
+        return;
+    }
     for (u32 i = 0; i < num; i++)
     {
         if (Write)
diff --git a/src/NDS_IOFast.cpp b/src/NDS_IOFast.cpp
index cc74418..2f23e3e 100644
--- a/src/NDS_IOFast.cpp
+++ b/src/NDS_IOFast.cpp
@@ -53,7 +53,7 @@ bool IOFastOn = IOFastRoutes != 0;
 static u32 ReadMemFastEnv()
 {
     const char* e = getenv("MELONDS_MEMFAST");
-    return e ? (u32)strtoul(e, nullptr, 0) & 0x7 : 0x7;
+    return e ? (u32)strtoul(e, nullptr, 0) & 0xF : 0xF;
 }
 
 u32 MemFastParts = ReadMemFastEnv();
diff --git a/src/NDS_IOFast.h b/src/NDS_IOFast.h
index 03d9da0..325bafb 100644
--- a/src/NDS_IOFast.h
+++ b/src/NDS_IOFast.h
@@ -74,6 +74,9 @@ enum
                             // static-address IO calls
     memfast_VRAMTrack = 4,  // VRAMTrackingSet::DeriveState returns at once when nothing was remapped since its
                             // last call (GPU::VRAMMapGen) and its banks have no dirty bit
+    memfast_WRAM7 = 8,      // the ARM7's slow accesses to its own WRAM (0x03800000-0x03FFFFFF) straight to it, on the
+                            // DS: NDS::ARM7Read*/ARM7Write*'s case 0x03800000 (the JIT check, the load or store)
+                            // without the virtual call and the region switch, a block's region checked once
 };
 
 extern bool IOStatsOn;
@@ -88,6 +91,7 @@ enum
     slow_IORead = iofast_IORead,
     slow_MemVRAM = memfast_VRAM << 4,
     slow_MemIO = memfast_IO << 4,
+    slow_MemWRAM7 = memfast_WRAM7 << 4,
     slow_FullPath = 1u << 31,
 };
 extern __attribute__((visibility("hidden"))) u32 SlowPathFlags;
