From cdffcb8294099e567a300c5495b06206d319c8de Mon Sep 17 00:00:00 2001
From: JorreFog <JorreFog@users.noreply.github.com>
Date: Sun, 11 Oct 2026 17:43:24 +0000
Subject: [PATCH 3/4] NDS: the scheduler slice as a setting, with an adaptive
 mode

kMaxIterationCycles (64) becomes NDS::SetSlice(slice, idle, hold): the
slice, and a longer one used while neither CPU has touched the IPC
registers or WRAMCNT for hold system cycles. idle == slice (the default)
is melonDS's fixed slice. The hooks sit on the IPC case labels of the IO
handlers, so other IO costs nothing; NextTarget gains one load and
compare. SliceIPCAccesses and SliceNearIPCCycles count, for statistics.
---
 src/NDS.cpp | 75 ++++++++++++++++++++++++++++++++++-------------------
 src/NDS.h   | 24 +++++++++++++++++
 2 files changed, 72 insertions(+), 27 deletions(-)

diff --git a/src/NDS.cpp b/src/NDS.cpp
index c6dc85f..153999b 100644
--- a/src/NDS.cpp
+++ b/src/NDS.cpp
@@ -49,7 +49,9 @@ namespace melonDS
 {
 using namespace Platform;
 
-const s32 kMaxIterationCycles = 64;
+// kMaxIterationCycles (64) is now NDS::SliceShort/SliceIdle (SetSlice). An event due less than
+// kIterationCycleMargin cycles after a slice's end ends that iteration instead: the slice stretches a little rather
+// than leave a sliver of an iteration before the event.
 const s32 kIterationCycleMargin = 8;
 
 // timing notes
@@ -507,6 +509,7 @@ void NDS::Reset()
     IPCFIFOCnt7 = 0;
     IPCFIFO9.Clear();
     IPCFIFO7.Clear();
+    SliceNearIPCUntil = 0;
 
     DivCnt = 0;
     SqrtCnt = 0;
@@ -813,6 +816,14 @@ void NDS::SetARM9BIOS(const std::array<u8, ARM9BIOSSize>& bios) noexcept
     ARM9BIOSNative = CRC32(ARM9BIOS.data(), ARM9BIOS.size()) == ARM9BIOSCRC32;
 }
 
+void NDS::SetSlice(s32 slice, s32 idle, u32 hold) noexcept
+{
+    SliceShort = slice > 0 ? slice : 64;
+    SliceIdle = idle > 0 ? idle : SliceShort;
+    SliceHold = hold;
+    SliceNearIPCUntil = 0;
+}
+
 u64 NDS::NextTarget()
 {
     u64 minEvent = UINT64_MAX;
@@ -830,7 +841,17 @@ u64 NDS::NextTarget()
         mask >>= 1;
     }
 
-    u64 max = SysTimestamp + kMaxIterationCycles;
+    // The adaptive slice (SetSlice): long slices only while neither CPU has touched the IPC registers or WRAMCNT
+    // for SliceHold cycles. Events already scheduled (timers, DMA, video, the IRQs they raise) still end a slice
+    // on time (the minEvent path), and so do the ARM9's new ones (Reschedule); what a longer slice coarsens is how
+    // the two CPUs' instruction streams interleave, and events the ARM7 schedules inside a slice, which run at its
+    // end, as at 64, but up to a slice late. The CPUs talk through the IPC registers, which the hooks see, and through
+    // main RAM, which they can't (fast memory): a handshake polled purely in main RAM (spinlocks, flags) still
+    // sees the other CPU's writes up to one idle slice late, and so does the first IPC access after a quiet
+    // period (the slice it lands in is already long). Shared WRAM is never visible to both CPUs at once
+    // (WRAMCNT gives each half to one of them), so only WRAMCNT writes, the hand-overs, are hooked.
+    // Hot path cost: one load and compare (and a select) per iteration; SliceIdle == SliceShort is melonDS's.
+    u64 max = SysTimestamp + (SysTimestamp < SliceNearIPCUntil ? SliceShort : SliceIdle);
 
     if (minEvent < max + kIterationCycleMargin)
         return minEvent;
@@ -2832,8 +2853,8 @@ u8 NDS::ARM9IORead8(u32 addr)
     case 0x04000132: return KeyCnt[0] & 0xFF;
     case 0x04000133: return KeyCnt[0] >> 8;
 
-    case 0x04000180: return IPCSync9 & 0xFF;
-    case 0x04000181: return IPCSync9 >> 8;
+    case 0x04000180: SliceIPC(0); return IPCSync9 & 0xFF;
+    case 0x04000181: SliceIPC(0); return IPCSync9 >> 8;
 
     case 0x040001A0: return NDSCartSlots[0]->ReadSPICnt(0) & 0xFF;
     case 0x040001A1: return NDSCartSlots[0]->ReadSPICnt(0) >> 8;
@@ -2943,8 +2964,8 @@ u16 NDS::ARM9IORead16(u32 addr)
     case 0x04000130: LagFrameFlag = false; return KeyInput & 0xFFFF;
     case 0x04000132: return KeyCnt[0];
 
-    case 0x04000180: return IPCSync9;
-    case 0x04000184:
+    case 0x04000180: SliceIPC(0); return IPCSync9;
+    case 0x04000184: SliceIPC(0);
         {
             u16 val = IPCFIFOCnt9;
             if (IPCFIFO9.IsEmpty())     val |= 0x0001;
@@ -3064,7 +3085,7 @@ u32 NDS::ARM9IORead32(u32 addr)
 
     case 0x04000130: LagFrameFlag = false; return (KeyInput & 0xFFFF) | (KeyCnt[0] << 16);
 
-    case 0x04000180: return IPCSync9;
+    case 0x04000180: SliceIPC(0); return IPCSync9;
     case 0x04000184: return NDS::ARM9IORead16(addr);
 
     case 0x040001A0: return NDSCartSlots[0]->ReadSPICnt(0) | (NDSCartSlots[0]->ReadSPIData(0) << 16);
@@ -3096,7 +3117,7 @@ u32 NDS::ARM9IORead32(u32 addr)
     case 0x04000300: return PostFlag9;
     case 0x04000304: return PowerControl9;
 
-    case 0x04100000:
+    case 0x04100000: SliceIPC(0);
         if (IPCFIFOCnt9 & 0x8000)
         {
             u32 ret;
@@ -3181,7 +3202,7 @@ void NDS::ARM9IOWrite8(u32 addr, u8 val)
         KeyCnt[0] = (KeyCnt[0] & 0x00FF) | (val << 8);
         return;
 
-    case 0x04000181:
+    case 0x04000181: SliceIPC(0);
         IPCSync7 &= 0xFFF0;
         IPCSync7 |= (val & 0x0F);
         IPCSync9 &= 0xB0FF;
@@ -3237,7 +3258,7 @@ void NDS::ARM9IOWrite8(u32 addr, u8 val)
     case 0x04000244: GPU.MapVRAM_E(4, val); return;
     case 0x04000245: GPU.MapVRAM_FG(5, val); return;
     case 0x04000246: GPU.MapVRAM_FG(6, val); return;
-    case 0x04000247: MapSharedWRAM(val); return;
+    case 0x04000247: SliceIPC(0); MapSharedWRAM(val); return;
     case 0x04000248: GPU.MapVRAM_H(7, val); return;
     case 0x04000249: GPU.MapVRAM_I(8, val); return;
 
@@ -3315,7 +3336,7 @@ void NDS::ARM9IOWrite16(u32 addr, u16 val)
         KeyCnt[0] = val;
         return;
 
-    case 0x04000180:
+    case 0x04000180: SliceIPC(0);
         IPCSync7 &= 0xFFF0;
         IPCSync7 |= ((val & 0x0F00) >> 8);
         IPCSync9 &= 0xB0FF;
@@ -3326,7 +3347,7 @@ void NDS::ARM9IOWrite16(u32 addr, u16 val)
         }
         return;
 
-    case 0x04000184:
+    case 0x04000184: SliceIPC(0);
         if (val & 0x0008)
             IPCFIFO9.Clear();
         if ((val & 0x0004) && (!(IPCFIFOCnt9 & 0x0004)) && IPCFIFO9.IsEmpty())
@@ -3338,7 +3359,7 @@ void NDS::ARM9IOWrite16(u32 addr, u16 val)
         IPCFIFOCnt9 = (val & 0x8404) | (IPCFIFOCnt9 & 0x4000);
         return;
 
-    case 0x04000188:
+    case 0x04000188: SliceIPC(0);
         NDS::ARM9IOWrite32(addr, val | (val << 16));
         return;
 
@@ -3403,7 +3424,7 @@ void NDS::ARM9IOWrite16(u32 addr, u16 val)
         GPU.MapVRAM_E(4, val & 0xFF);
         GPU.MapVRAM_FG(5, val >> 8);
         return;
-    case 0x04000246:
+    case 0x04000246: SliceIPC(0);
         GPU.MapVRAM_FG(6, val & 0xFF);
         MapSharedWRAM(val >> 8);
         return;
@@ -3504,7 +3525,7 @@ void NDS::ARM9IOWrite32(u32 addr, u32 val)
     case 0x04000184:
         NDS::ARM9IOWrite16(addr, val);
         return;
-    case 0x04000188:
+    case 0x04000188: SliceIPC(0);
         if (IPCFIFOCnt9 & 0x8000)
         {
             if (IPCFIFO9.IsFull())
@@ -3557,7 +3578,7 @@ void NDS::ARM9IOWrite32(u32 addr, u32 val)
         GPU.MapVRAM_CD(2, (val >> 16) & 0xFF);
         GPU.MapVRAM_CD(3, val >> 24);
         return;
-    case 0x04000244:
+    case 0x04000244: SliceIPC(0);
         GPU.MapVRAM_E(4, val & 0xFF);
         GPU.MapVRAM_FG(5, (val >> 8) & 0xFF);
         GPU.MapVRAM_FG(6, (val >> 16) & 0xFF);
@@ -3656,8 +3677,8 @@ u8 NDS::ARM7IORead8(u32 addr)
 
     case 0x04000138: return RTC.Read() & 0xFF;
 
-    case 0x04000180: return IPCSync7 & 0xFF;
-    case 0x04000181: return IPCSync7 >> 8;
+    case 0x04000180: SliceIPC(1); return IPCSync7 & 0xFF;
+    case 0x04000181: SliceIPC(1); return IPCSync7 >> 8;
 
     case 0x040001A0: return NDSCartSlots[0]->ReadSPICnt(1) & 0xFF;
     case 0x040001A1: return NDSCartSlots[0]->ReadSPICnt(1) >> 8;
@@ -3720,8 +3741,8 @@ u16 NDS::ARM7IORead16(u32 addr)
 
     case 0x04000138: return RTC.Read();
 
-    case 0x04000180: return IPCSync7;
