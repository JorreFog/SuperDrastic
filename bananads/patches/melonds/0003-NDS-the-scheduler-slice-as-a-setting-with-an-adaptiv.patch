diff --git a/src/NDS.h b/src/NDS.h
index 729706b..30b0ddd 100644
--- a/src/NDS.h
+++ b/src/NDS.h
@@ -277,6 +277,15 @@ public: // TODO: Encapsulate the rest of these members
     u64 ARM7Timestamp, ARM7Target;
     u32 ARM9ClockShift;
 
+    // The scheduler slice (BananaDS): the most system cycles one iteration of RunFrame's loop runs the CPUs for
+    // before they are interleaved again (melonDS: 64). slice is used within hold cycles of either CPU's last
+    // access to the IPC registers (IPCSYNC, IPCFIFOCNT, IPCFIFOSEND, IPCFIFORECV) or to WRAMCNT, idle the rest of
+    // the time; idle == slice (the default) is a fixed slice. SliceIPCAccesses and SliceNearIPCCycles count, for
+    // statistics (the frontend may reset them), the accesses and roughly how much emulated time ran near one.
+    void SetSlice(s32 slice, s32 idle, u32 hold) noexcept;
+    u64 SliceIPCAccesses = 0;
+    u64 SliceNearIPCCycles = 0;
+
     u32 IME[2];
     u32 IE[2];
     u32 IF[2];
@@ -509,6 +518,21 @@ protected:
     void InitTimings();
     u32 SchedListMask;
     u64 SysTimestamp;
+    s32 SliceShort = 64;
+    s32 SliceIdle = 64;
+    u32 SliceHold = 0;
+    u64 SliceNearIPCUntil = 0; // the short slice is used while SysTimestamp is below this
+    void SliceIPC(u32 cpu) noexcept
+    {
+        const u64 now = cpu ? ARM7Timestamp : (ARM9Timestamp >> ARM9ClockShift);
+        const u64 until = now + SliceHold;
+        SliceIPCAccesses++;
+        if (until > SliceNearIPCUntil)
+        {
+            SliceNearIPCCycles += until - (now > SliceNearIPCUntil ? now : SliceNearIPCUntil);
+            SliceNearIPCUntil = until;
+        }
+    }
     u8 WRAMCnt;
     u8 PostFlag9;
     u8 PostFlag7;
