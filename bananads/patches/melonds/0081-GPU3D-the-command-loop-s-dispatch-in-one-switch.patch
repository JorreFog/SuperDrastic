         }
         else
             RunFastFIFO();
@@ -2924,6 +2972,13 @@ __attribute__((no_stack_protector)) void GPU3D::RunFast() noexcept
     }
 }
 
+bool GPU3D::GeomSwitchEnv() noexcept
+{
+    // read as the GPU3D is created (a difftest's two NDS objects each with its own setting)
+    const char* e = getenv("MELONDS_GEOMSWITCH");
+    return !(e && e[0] == '0');
+}
+
 bool GPU3D::GeomQueueEnv() noexcept
 {
     // read as the GPU3D is created (a difftest's two NDS objects each with its own setting)
diff --git a/src/GPU3D.h b/src/GPU3D.h
index c50f42b..8b1e02f 100644
--- a/src/GPU3D.h
+++ b/src/GPU3D.h
@@ -140,7 +140,9 @@ private:
     void WriteGXFIFOPortFast(u32 val) noexcept;
     void Write32Plain(u32 addr, u32 val) noexcept;
     template<bool Fast> void ExecuteCommandBody() noexcept;
-    template<bool Fast> void ExecuteEntryBody(CmdFIFOEntry entry, bool& countsChanged) noexcept;
+    template<bool Fast, bool OneSwitch = false> void ExecuteEntryBody(CmdFIFOEntry entry, bool& countsChanged) noexcept;
+    template<bool OneSwitch> void RunQueue() noexcept;
+    void RunQueueOld() noexcept;
     void RunFastLoop() noexcept;
     void RunFastFIFO() noexcept;
     template<bool Fast> void SubmitVertexBody() noexcept;
@@ -425,6 +427,12 @@ public:
     // command only after one that lowered their counts (nothing else changes them while the commands run)
     static bool GeomQueueEnv() noexcept;
     bool GeomQueue = GeomQueueEnv();
+    // BananaDS (render.geom_switch, MELONDS_GEOMSWITCH=0 turns it off; exact): GeomQueue's loop dispatches every
+    // command with one switch on it (the same statements per command), the ones with more than one parameter going
+    // to their path from there and a full vertex's two entries with a path of their own, instead of looking up the
+    // parameter count first and switching on the command again for a first or last parameter
+    static bool GeomSwitchEnv() noexcept;
+    bool GeomSwitch = GeomSwitchEnv();
     // while RunFast defers them, and whether one of the checks was due
     bool FIFOChecksDeferred = false;
     bool FIFOChecksDue = false;
