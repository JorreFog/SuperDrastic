@@ -1037,6 +1037,9 @@
 // (read at the first use: BananaDS sets the variable from its settings after the program has started)
 static bool HotSmcOn() { static const bool on = [] { const char* e = getenv("MELONDS_JIT_HOTSMC"); return !(e && e[0] == '0'); }(); return on; }
 
+// MELONDS_JIT_HOTIDX=0: no index, every write scans its range's blocks as before (read at the first use)
+static bool HotIdxOn() { static const bool on = [] { const char* e = getenv("MELONDS_JIT_HOTIDX"); return !(e && e[0] == '0'); }(); return on; }
