+
+void ARMJIT::IndexRange(AddressRange* range, u32 rangeAddr) noexcept
+{
+    auto& v = HotRangeIdx[range];
+    v.clear();
+    for (int i = 0; i < range->Blocks.Length; i++)
+    {
+        JitBlock* block = range->Blocks[i];
+        for (int j = 0; j < block->NumAddresses; j++)
+            if (block->AddressRanges()[j] == rangeAddr) { v.emplace_back(block, block->AddressMasks()[j]); break; }
     }
 }
 
