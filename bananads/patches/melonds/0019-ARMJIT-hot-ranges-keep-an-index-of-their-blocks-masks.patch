     }
 
     if (cpu->Num == 0)
@@ -1472,6 +1478,25 @@
     AddressRange* range = &region[(localAddr & 0x7FFFFFF) / 512];
     u32 mask = 1 << ((localAddr & 0x1FF) / 16);
 
+    // (patch 0018) a hot range: its index says which blocks hold the written 16 bytes, without touching the others
+    if (!HotRangeIdx.empty())
+        if (auto ix = HotRangeIdx.find(range); ix != HotRangeIdx.end())
+        {
+            auto& v = ix->second;
+            u32 code = 0;
+            for (size_t q = 0; q < v.size();)
+            {
+                if (!(v[q].second & mask)) { code |= v[q].second; q++; continue; }
+                JitBlock* block = v[q].first;
+                v.erase(v.begin() + q);
+                bool removed = range->Blocks.RemoveByValue(block);
+                assert(removed);
+                InvalidateBlock(block, range, region, localAddr);
+            }
+            range->Code = code;
+            return;
+        }
+
     range->Code = 0;
     for (int i = 0; i < range->Blocks.Length;)
     {
@@ -1499,72 +1524,96 @@
             continue;
         }
         range->Blocks.Remove(i);
