 using namespace Arm64Gen;
 
 extern "C" void ARM_Ret();
+// block linking: the exit slot that took its link path and its CPU (ARM_Dispatch calls melonds_jit_link_pending
+// when the slot is set)
+extern "C" uint64_t melonds_jit_link[2];
+uint64_t melonds_jit_link[2] = {0, 0};
 
 namespace melonDS
 {
@@ -260,6 +268,8 @@ Compiler::Compiler(melonDS::NDS& nds) : Arm64Gen::ARM64XEmitter(), NDS(nds)
         JumpToFuncs9[i] = Gen_JumpTo9(i);
         JumpToFuncs7[i] = Gen_JumpTo7(i);
     }
+    Gen_ExitStubs(0);
+    Gen_ExitStubs(1);
 
     /*
         W4 - whether the register was written to
@@ -448,6 +458,42 @@ Compiler::Compiler(melonDS::NDS& nds) : Arm64Gen::ARM64XEmitter(), NDS(nds)
     JitMemMainSize -= JitMemSecondarySize;
 
     SetCodeBase((u8*)GetRWPtr(), (u8*)GetRXPtr());
+
+    // DynExit's code base, now that it is known
+    const u64 base = (u64)(uintptr_t)GetRXBase();
+    for (int num = 0; num < 2; num++)
+    {
+        u32* p = DynExitBase[num];
+        p[0] = 0xD2800000 | ((u32)(base & 0xFFFF) << 5) | 17;                       // movz x17, #.., lsl #0
+        for (int hw = 1; hw < 4; hw++)
+            p[hw] = 0xF2800000 | (hw << 21) | ((u32)((base >> (16 * hw)) & 0xFFFF) << 5) | 17;  // movk x17, #.., lsl #16*hw
+        FlushIcacheSection((u8*)p, (u8*)(p + 4));
+    }
+
+    LinkBlocks = !getenv("MELONDS_JIT_NOLINK");
+    if (getenv("MELONDS_JIT_PERFMAP"))
+    {
+        char path[64];
+        snprintf(path, sizeof(path), "/tmp/perf-%d.map", (int)getpid());
+        PerfMap = fopen(path, "w");
+        snprintf(path, sizeof(path), "/tmp/melonjit-%d.code", (int)getpid());
+        CodeDump = fopen(path, "wb");
+    }
+}
+
+void Compiler::DumpBlock(const char* name, u32 addr, const u8* start, const u8* end)
+{
+    // perf's JIT map ("start size name") and the code itself (u64 start, u32 size, the bytes), for profiling
+    if (!PerfMap || end <= start)
+        return;
+    fprintf(PerfMap, "%lx %lx %s_%08x\n", (unsigned long)(uintptr_t)start, (unsigned long)(end - start), name, addr);
+    fflush(PerfMap);
+    u64 at = (u64)(uintptr_t)start;
+    u32 n = (u32)(end - start);
+    fwrite(&at, 8, 1, CodeDump);
+    fwrite(&n, 4, 1, CodeDump);
+    fwrite(start, 1, n, CodeDump);
+    fflush(CodeDump);
 }
 
 Compiler::~Compiler()
@@ -669,8 +715,168 @@ void Compiler::Comp_BranchSpecialBehaviour(bool taken)
 
         if (ConstantCycles)
             ADD(RCycles, RCycles, ConstantCycles);
+        if (taken)
+            Comp_Exit(LastJumpKnown, LastJumpR15, LastJumpThumb);
+        else
+            Comp_Exit(true, R15, Thumb);    // not taken: on to the next instruction (its R15 is stored)
+    }
+}
+
+void Compiler::Comp_Exit(bool known, u32 knownR15, bool thumbAfter)
+{
+    if (!LinkBlocks)
+    {
         QuickTailCall(X0, ARM_Ret);
+        return;
+    }
+
+    if (!known)
+    {
+        B(DynExit[Num]);
+        return;
+    }
+
+    // the checks (ExitCheck), then the slot: a B to its link path in the far region, until ARM_Dispatch links it
+    BL(ExitCheck[Num]);
+    u8* slot = GetWriteableRWPtr();
+    u8* slotRX = (u8*)GetRXPtr();
+    SwapCodeRegion();
+    u8* linkPath = (u8*)GetRXPtr();
+    SwapCodeRegion();
+    B(linkPath);
+    LinkSlots[(u32)(slotRX - GetRXBase())] = {*(u32*)slot, knownR15, Num | (thumbAfter ? 2u : 0u)};
+
+    // the link path: ask ARM_Dispatch to link the slot to the block the loop dispatches next, then back to it
+    SwapCodeRegion();
+    MOVP2R(X16, slotRX);
+    MOVP2R(X17, &melonds_jit_link[0]);
+    STP(INDEX_SIGNED, X16, RCPU, X17, 0);
+    QuickTailCall(X16, ARM_Ret);
+    FlushIcacheSection(linkPath, (u8*)GetRXPtr());   // (the far region's code isn't in CompileBlock's flush)
+    SwapCodeRegion();
+}
+
+void Compiler::Gen_ExitStubs(int num)
+{
+    // ExitCheck (a BL from an exit with a known target): what ARMv5/ARMv4::Execute's loop does after a block.
+    // StopExecution (an IRQ, a halt, an idle loop) is the loop's to handle; otherwise Timestamp += Cycles,
+    // Cycles = 0, and on (a return to the exit's slot) while Timestamp < Target. Back to the loop is a return
+    // to ARM_Ret, which keeps the return stack in step.
+    u64* ts = num ? &NDS.ARM7Timestamp : &NDS.ARM9Timestamp;   // its Target is the next u64
+    ExitCheck[num] = GetRXPtr();
+    {
+        LDR(INDEX_UNSIGNED, W0, RCPU, offsetof(ARM, StopExecution));
+        FixupBranch stop = CBNZ(W0);
+        MOVP2R(X16, ts);
+        LDP(INDEX_SIGNED, X17, X0, X16, 0);
+        SXTW(X1, RCycles);
+        ADD(X17, X17, X1);
+        STR(INDEX_UNSIGNED, X17, X16, 0);
+        MOVI2R(RCycles, 0);
+        CMP(X17, X0);
+        FixupBranch late = B(CC_HS);
+        STR(INDEX_UNSIGNED, RCPSR, RCPU, offsetof(ARM, CPSR));   // (the next block reads it from memory)
+        RET();
+        SetJumpTarget(stop);
+        SetJumpTarget(late);
+        MOVP2R(X30, (void*)ARM_Ret);
+        RET();
     }
+
+    // DynExit (a B from an exit whose target is only known at run time, in R15 and the CPSR's T bit): the same
+    // checks, then the block from FastBlockLookup as the loop finds it: instrAddr = R15 - (Thumb ? 2 : 4); outside
+    // FastBlockLookupStart/Size, back to the loop (it sets the region up); the block is
+    // FastBlockLookup[(instrAddr - Start) / 2] when that entry's upper half is (instrAddr | Num), else back (to
+    // compile it)
+    DynExit[num] = GetRXPtr();
+    {
+        LDR(INDEX_UNSIGNED, W0, RCPU, offsetof(ARM, StopExecution));
+        FixupBranch stop = CBNZ(W0);
+        MOVP2R(X16, ts);
+        LDP(INDEX_SIGNED, X17, X0, X16, 0);
+        SXTW(X1, RCycles);
+        ADD(X17, X17, X1);
+        STR(INDEX_UNSIGNED, X17, X16, 0);
+        MOVI2R(RCycles, 0);
+        CMP(X17, X0);
+        FixupBranch late = B(CC_HS);
+        STR(INDEX_UNSIGNED, RCPSR, RCPU, offsetof(ARM, CPSR));
+
+        LDR(INDEX_UNSIGNED, W0, RCPU, offsetof(ARM, R[15]));
+        UBFX(W1, RCPSR, 5, 1);
+        MOVI2R(W2, 4);
+        SUB(W1, W2, W1, ArithOption(W1, ST_LSL, 1));
+        SUB(W0, W0, W1);
+        LDR(INDEX_UNSIGNED, W16, RCPU, offsetof(ARM, FastBlockLookupStart));
+        SUB(W17, W0, W16);
+        LDR(INDEX_UNSIGNED, W16, RCPU, offsetof(ARM, FastBlockLookupSize));
+        CMP(W17, W16);
+        FixupBranch outside = B(CC_HS);
+        LDR(INDEX_UNSIGNED, X16, RCPU, offsetof(ARM, FastBlockLookup));
+        LSR(W17, W17, 1);
+        LDR(X16, X16, ArithOption(X17, true));
+        if (num)
+            ORRI2R(W0, W0, 1);
+        CMP(X0, X16, ArithOption(X16, ST_LSR, 32));
+        FixupBranch miss = B(CC_NEQ);
+        // the blocks' code base (GetRXBase() once the constructor has moved it past the stubs): four
+        // instructions that the constructor fills in then (MOVZ/MOVK into X17)
+        DynExitBase[num] = (u32*)GetWriteableRWPtr();
+        for (int i = 0; i < 4; i++)
+            Write32(0xD503201F);
+        ADD(X16, X17, W16, ArithOption(W16));   // + the entry's offset (uxtw)
+        BR(X16);
+        SetJumpTarget(stop);
+        SetJumpTarget(late);
+        SetJumpTarget(outside);
+        SetJumpTarget(miss);
+        QuickTailCall(X16, ARM_Ret);
+    }
+}
+
+void Compiler::Link(u8* slotRX, ARM* cpu, u8* entry)
+{
+    const u32 off = (u32)(slotRX - GetRXBase());
+    auto it = LinkSlots.find(off);
+    if (it == LinkSlots.end() || it->second.r15 != cpu->R[15]
+        || it->second.num != (cpu->Num | ((cpu->CPSR & 0x20) ? 2u : 0u)))
+        return;
+    const s64 d = ((s64)(entry - GetRXBase()) - (s64)off) / 4;
+    if (d < -(1 << 25) || d >= (1 << 25))
+        return;
+    NDS.JIT.JitEnableWrite();
+    u32* slot = (u32*)(RWBase() + off);
+    *slot = 0x14000000 | ((u32)d & 0x3FFFFFF);
+    NDS.JIT.JitEnableExecute();
+    FlushIcacheSection((u8*)slotRX, (u8*)slotRX + 4);
+    LinkedTo[(u32)(entry - GetRXBase())].push_back(off);
+}
+
+void Compiler::UnlinkBlock(JitBlockEntry entry)
+{
+    auto it = LinkedTo.find((u32)((u8*)entry - GetRXBase()));
+    if (it == LinkedTo.end())
+        return;
+    NDS.JIT.JitEnableWrite();
+    for (u32 off : it->second)
+    {
+        auto s = LinkSlots.find(off);
+        if (s == LinkSlots.end())
+            continue;
+        *(u32*)(RWBase() + off) = s->second.orig;
+        FlushIcacheSection(GetRXBase() + off, GetRXBase() + off + 4);
+    }
+    NDS.JIT.JitEnableExecute();
+    LinkedTo.erase(it);
+}
+
+extern "C" void melonds_jit_link_pending(ARM* cpu, u8* entry)
+{
+    u8* slot = (u8*)(uintptr_t)melonds_jit_link[0];
+    ARM* from = (ARM*)(uintptr_t)melonds_jit_link[1];
+    melonds_jit_link[0] = 0;
+    if (from == cpu)
+        cpu->NDS.JIT.JITCompiler.Link(slot, cpu, entry);
 }
 
 JitBlockEntry Compiler::CompileBlock(ARM* cpu, bool thumb, FetchedInstr instrs[], int instrsCount, bool hasMemInstr)
@@ -687,6 +893,7 @@ JitBlockEntry Compiler::CompileBlock(ARM* cpu, bool thumb, FetchedInstr instrs[]
     }
 
     JitBlockEntry res = (JitBlockEntry)GetRXPtr();
+    const ptrdiff_t farStart = OtherCodeRegion;
 
     Thumb = thumb;
     Num = cpu->Num;
@@ -703,6 +910,7 @@ JitBlockEntry Compiler::CompileBlock(ARM* cpu, bool thumb, FetchedInstr instrs[]
         CurInstr = instrs[i];
         R15 = CurInstr.Addr + (Thumb ? 4 : 8);
         CodeRegion = R15 >> 24;
+        LastJumpKnown = false;
 
         CompileFunc comp = Thumb
             ? T_Comp[CurInstr.Info.Kind]
@@ -821,16 +1029,35 @@ JitBlockEntry Compiler::CompileBlock(ARM* cpu, bool thumb, FetchedInstr instrs[]
 
     if (ConstantCycles)
         ADD(RCycles, RCycles, ConstantCycles);
-    QuickTailCall(X0, ARM_Ret);
+    {
+        // the block's own end: on to the next instruction, or where its last instruction jumped (when constant)
+        const FetchedInstr& last = instrs[instrsCount - 1];
+        const bool cond = Thumb ? last.Info.Kind == ARMInstrInfo::tk_BCOND : last.Cond() < 0xE;
+        if (!last.Info.Branches())
+            Comp_Exit(true, R15, Thumb);
+        else if (LastJumpKnown && !cond)
+            Comp_Exit(true, LastJumpR15, LastJumpThumb);
+        else
+            Comp_Exit(false, 0, Thumb);
+    }
 
     FlushIcache();
 
+    if (PerfMap)
+    {
+        DumpBlock(Num ? "mj7" : "mj9", instrs[0].Addr, (const u8*)res, (const u8*)GetRXPtr());
+        DumpBlock(Num ? "mj7f" : "mj9f", instrs[0].Addr, GetRXBase() + farStart, GetRXBase() + OtherCodeRegion);
+    }
+
     return res;
 }
 
 void Compiler::Reset()
 {
     LoadStorePatches.clear();
+    LinkSlots.clear();
+    LinkedTo.clear();
+    melonds_jit_link[0] = 0;
 
     SetCodePtr(0);
     OtherCodeRegion = JitMemMainSize;
diff --git a/src/ARMJIT_A64/ARMJIT_Compiler.h b/src/ARMJIT_A64/ARMJIT_Compiler.h
index 5a79d8b9..afced8f3 100644
--- a/src/ARMJIT_A64/ARMJIT_Compiler.h
+++ b/src/ARMJIT_A64/ARMJIT_Compiler.h
@@ -28,7 +28,9 @@
 #include "../ARMJIT_Internal.h"
 #include "../ARMJIT_RegisterCache.h"
 
+#include <stdio.h>
 #include <unordered_map>
+#include <vector>
 
 namespace melonDS
 {
@@ -224,6 +226,32 @@ public:
 
     void Comp_BranchSpecialBehaviour(bool taken);
 
+    // Block linking: a block's exit does what ARMv5/ARMv4::Execute's JIT loop does between two blocks
+    // (StopExecution, Timestamp += Cycles against Target) and goes on into the next block itself. An exit whose
+    // target is known when compiling has a slot: a B that ARM_Dispatch patches to the target block once the loop
+    // has dispatched it after this exit (melonds_jit_link, Link), and that UnlinkBlock puts back when the framework
+    // retires or invalidates the target. Other exits look the next block up in FastBlockLookup.
+    void Comp_Exit(bool known, u32 knownR15, bool thumbAfter);
+    void Gen_ExitStubs(int num);
+    void* ExitCheck[2] = {};
+    void* DynExit[2] = {};
+    u32* DynExitBase[2] = {};
+    void Link(u8* slotRX, ARM* cpu, u8* entry);
+    void UnlinkBlock(JitBlockEntry entry);
+    bool LastJumpKnown = false;   // the instruction being compiled jumped to a constant address (Comp_JumpTo(u32))
+    u32 LastJumpR15 = 0;
+    bool LastJumpThumb = false;
+    struct LinkSlot { u32 orig; u32 r15; u32 num; };          // num: the CPU's, | 2 when the target is Thumb code
+    std::unordered_map<u32, LinkSlot> LinkSlots;              // a slot's offset in code memory -> its link path's B
+    std::unordered_map<u32, std::vector<u32>> LinkedTo;       // a block's entry offset -> the slots that jump to it
+    bool LinkBlocks = true;       // MELONDS_JIT_NOLINK=1: every exit goes back to the loop, as melonDS's does
+    u8* RWBase() { return GetWriteableRWPtr() - GetCodeOffset(); }
+
+    // MELONDS_JIT_PERFMAP=1: /tmp/perf-<pid>.map for perf, and the blocks' code in /tmp/melonjit-<pid>.code
+    void DumpBlock(const char* name, u32 addr, const u8* start, const u8* end);
+    FILE* PerfMap = nullptr;
+    FILE* CodeDump = nullptr;
+
     JitBlockEntry AddEntryOffset(u32 offset)
     {
         return (JitBlockEntry)(GetRXBase() + offset);
diff --git a/src/ARMJIT_A64/ARMJIT_Linkage.S b/src/ARMJIT_A64/ARMJIT_Linkage.S
index 83d910a3..40a70f42 100644
--- a/src/ARMJIT_A64/ARMJIT_Linkage.S
+++ b/src/ARMJIT_A64/ARMJIT_Linkage.S
@@ -40,6 +40,23 @@ ARM_Dispatch:
     stp x27, x28, [sp, #64]
     stp x29, x30, [sp, #80]
 
+    // block linking: link the exit that just came back here (its slot in melonds_jit_link) to this block
+#ifdef __APPLE__
+    adrp x2, _melonds_jit_link@PAGE
+    ldr x2, [x2, _melonds_jit_link@PAGEOFF]
+#else
+    adrp x2, melonds_jit_link
+    ldr x2, [x2, :lo12:melonds_jit_link]
+#endif
+    cbz x2, 1f
+    stp x0, x1, [sp, #-16]!
+#ifdef __APPLE__
+    bl _melonds_jit_link_pending
+#else
+    bl melonds_jit_link_pending
+#endif
+    ldp x0, x1, [sp], #16
+1:
     mov RCPU, x0
     ldr RCycles, [RCPU, ARM_Cycles_offset]
     ldr RCPSR, [RCPU, ARM_CPSR_offset]
