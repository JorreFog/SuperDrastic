+void Compiler::Gen_ExitStubsPinned()
+{
+    // PINTS (patch 0320): the ARM9's exit stubs with Timestamp/Target/cycles in x25/x18/w28 (the convention:
+    // ARMJIT_Compiler.h). The hot way through an exit is one TBNZ (not taken) and one SUB. The late way (w28 < 0:
+    // Timestamp + Cycles >= Target, or StopExecution folded in) reads StopExecution and does what ExitCheck's did,
+    // then stores Timestamp and Cycles for the loop. Same layout as Gen_ExitStubs(0), at index 2.
+    const int idx = 2;
+    const bool chain = OptSliceChain;   // (OptExitStub holds: PinTsOK)
+    auto callChain = [&]()
+    {
+        // Timestamp to memory (SliceChain9 reads it), the call (x0 = &NDS and x16 = SliceChain9 from literals), then
+        // x18 and w28 from the Target it set (a new slice: no cycles charged yet). x4 and x30 kept round it.
+        STP(INDEX_PRE, X4, X30, SP, -16);
+        EmitPinCallBefore();
+        const bool pad = ((uintptr_t)GetRXPtr() + 16) & 7;
+        Write32(0x10000000 | ((pad ? 5 : 4) << 5) | 16);   // adr x16, <the literals below>
+        LDP(INDEX_SIGNED, X0, X16, X16, 0);
+        BLR(X16);
+        FixupBranch over = B();
+        if (pad)
+            Write32(0xD503201F);
+        const u64 lits[2] = {(u64)(uintptr_t)&NDS, (u64)(uintptr_t)&melonDS::NDS::SliceChain9};
+        for (u64 v : lits)
+        {
+            Write32((u32)v);
+            Write32((u32)(v >> 32));
+        }
+        SetJumpTarget(over);
+        EmitPinTsAddr(X17);
+        LDR(INDEX_UNSIGNED, X18, X17, PinTsOff + 8);
+        SUB(X18, X18, 1);
+        SUB(X17, X18, X25);
+        MOV(RCycles, W17);
+        LDP(INDEX_POST, X4, X30, SP, 16);
+    };
+    auto retToLoop = [&]()
+    {
+        const bool pad = ((uintptr_t)GetRXPtr() + 8) & 7;
+        Write32(0x58000000 | ((pad ? 3 : 2) << 5) | 30);   // ldr x30, <the literal below>
+        RET();
+        if (pad)
+            Write32(0xD503201F);
+        const u64 ret = (u64)(uintptr_t)ARM_Ret;
+        Write32((u32)ret);
+        Write32((u32)(ret >> 32));
+    };
+
+    StubsStart[4] = GetRXPtr();
+    for (int c = 1; c >= 0; c--)
+    {
+        if (c && OptFlagStub)
+        {
+            ExitCheckPCF[idx] = GetRXPtr();
+            MRS(X17, FIELD_NZCV);
+            ANDI2R(RCPSR, RCPSR, 0x0FFFFFFF);
+            ORR(RCPSR, RCPSR, W17);
+        }
