+void Compiler::EmitPinTsAddr(ARM64Reg reg)
+{
+    if (!PinTsShort)
+        MOVP2R(reg, &NDS.ARM9Timestamp);
+    else if (PinTsHi >= 0)
+        ADD(reg, RCPU, (u32)PinTsHi, true);
+    else
+        SUB(reg, RCPU, (u32)-PinTsHi, true);
+}
+
+void Compiler::EmitPinCallBefore()
+{
+    EmitPinTsAddr(X17);
+    STR(INDEX_UNSIGNED, X25, X17, PinTsOff);
+}
+
+void Compiler::EmitPinCallAfter()
+{
+    // x18' = Target - 1, or the fold; w28 += x18' - x18 (the cycles charged so far stay counted); no flags touched
+    EmitPinTsAddr(X17);
+    LDR(INDEX_UNSIGNED, X2, X17, PinTsOff + 8);
+    SUB(X2, X2, 1);
+    LDR(INDEX_UNSIGNED, W1, RCPU, offsetof(ARM, StopExecution));
+    FixupBranch clear = CBZ(W1);
+    SUB(X2, X25, 0x400, true);
+    SetJumpTarget(clear);
+    SUB(X1, X2, X18);
+    ADD(RCycles, RCycles, W1);
+    MOV(X18, X2);
+}
+
+void Compiler::PinFoldStop()
+{
+    SUB(X17, X25, 0x400, true);
+    SUB(X16, X17, X18);
+    ADD(RCycles, RCycles, W16);
+    MOV(X18, X17);
+}
+
+void Compiler::PinRetSync(bool checked)
+{
+    EmitPinCallBefore();
+    if (checked)
+        MOVI2R(RCycles, 0);
+    else
+    {
+        SUB(X17, X18, X25);
+        SUB(RCycles, W17, RCycles);
+    }
+}
+
+void Compiler::SubSxtw(ARM64Reg rd, ARM64Reg rn, ARM64Reg wm)
+{
+    Write32(0xCB200000 | ((u32)DecodeReg(wm) << 16) | (6 << 13) | ((u32)DecodeReg(rn) << 5) | (u32)DecodeReg(rd));
+}
+
+FixupBranch Compiler::PinChecksHot()
+{
+    FixupBranch slow = TBNZ(RCycles, 31);
+    SubSxtw(X25, X18, RCycles);   // Timestamp += Cycles
+    return slow;
+}
+
+void Compiler::PinChecksSlow(FixupBranch slow, FixupBranch& stop)
+{
+    SetJumpTarget(slow);
+    LDR(INDEX_UNSIGNED, W17, RCPU, offsetof(ARM, StopExecution));
+    stop = CBNZ(W17);
+    SubSxtw(X25, X18, RCycles);
+}
+
+void Compiler::CycAdd(s32 cycles)
+{
+    if (cycles == 0)
+        return;
+    if (Pinned())
+        cycles = -cycles;
+    if (cycles > 0)
+        ADD(RCycles, RCycles, cycles);
+    else
+        SUB(RCycles, RCycles, -cycles);
+}
+
+void Compiler::CycAdd(ARM64Reg w)
+{
+    if (Pinned())
+        SUB(RCycles, RCycles, w);
+    else
+        ADD(RCycles, RCycles, w);
+}
