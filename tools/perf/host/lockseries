#!/bin/sh
RG="env RGDS_HOST=${RGDS_HOST:?set RGDS_HOST} ${RGDS_RG:-$HOME/.cache/rgds/rg}"
run() { tag=$1 lib=$2; shift 2
  $RG "systemctl reset-failed pacetest 2>/dev/null; systemd-run --unit=pacetest --collect --wait -q -p StandardOutput=file:/tmp/pace.out -p StandardError=file:/tmp/pace.err sh /storage/dsflip/opt/pace.sh $tag $lib hg 60 $*; cat /tmp/pace.out; head -c 300 /tmp/pace.err; grep -E 'locked to|resampled here|screen colours' /storage/dsflip/opt/runs/$tag.log | head -3; i=0; while [ \$i -lt 60 ]; do curl -s localhost:1234/isIdle 2>/dev/null | grep -q true && break; sleep 1; i=\$((i+1)); done; echo \"(menu back after \$i s)\""
  echo
}
N=/storage/dsflip/opt/lib/cur6.so
run p2-lock-a $N DSFLIP_AUDIO_RATE=48000 DSFLIP_AUDIO_LOCK=60.00492
run p2-rs-a $N DSFLIP_AUDIO_RATE=48000
run p2-lock-b $N DSFLIP_AUDIO_RATE=48000 DSFLIP_AUDIO_LOCK=60.00492
run p3-lock $N DSFLIP_AUDIO_RATE=48000 DSFLIP_AUDIO_LOCK=60.00492 DSFLIP_RAST_SCALE=3
$RG "md5sum /storage/.config/drastic/dsflip/libdsflip.so | cut -c1-32; systemctl show-environment | grep -c DSFLIP; systemctl is-active sway essway dsflip-game"
echo done
